//@version=5
// HOW TO LOAD (avoids CE10243 error):
// 1. Open Pine Editor in TradingView
// 2. Click dropdown next to "Open" -> "New script"
// 3. Press Ctrl+A (select all) then Delete
// 4. Paste this entire file
// 5. Click "Add to chart"
//
// ═══════════════════════════════════════════════════════════════════════════
// BREAKOUT-CONTINUATION v2 | Close-Confirmed, 61.8% SL, 161.8% TP Extension
// Strategy #4 — the only variant across 16 tried that is net-positive in
// both halves of a 2-year walk-forward split (at 5% zig-zag threshold).
//
// What v2 fixes vs v1:
//   1. Entry requires a full CLOSE beyond the breakout level, not a wick.
//      Fill is at the NEXT bar's OPEN (no lookahead).
//   2. Stop loss is anchored to the breakout level, not the leg origin:
//      SL = breakout_level ± 61.8% of the leg's own range.
//      Risk scales with volatility; structurally tighter than v1.
//   3. Take profit extended to 161.8% of the leg range from breakout level.
//      Reward is consistently larger than risk.
//
// Backtested edge: 42.9% WR, +$88 net at 5% ZZ over 2 years (7 trades).
// Signal is rare (~1 per 10 weeks). This is data; treat it that way.
// ═══════════════════════════════════════════════════════════════════════════
strategy("BC-v2 · Confirmed Breakout (Validated)", shorttitle="BC-v2",
     overlay=true, pyramiding=0,
     initial_capital=5000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     currency=currency.USD,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2)

// ── Inputs ─────────────────────────────────────────────────────────────────
var string G1 = "Zig-Zag"
zz_pct      = input.float(5.0,  "Reversal Threshold %",  minval=1.0, maxval=30.0, step=0.5, tooltip="5% is the walk-forward validated setting", group=G1) / 100
var string G2 = "v2 Exit Parameters"
sl_frac     = input.float(61.8, "SL Giveback %",         minval=20.0, maxval=100.0, step=1.0, tooltip="Default 61.8% of leg range given back from breakout level", group=G2) / 100
tp_ext      = input.float(161.8,"TP Extension %",         minval=100.0, maxval=300.0, step=1.0, tooltip="Default 161.8% of leg range projected from breakout level", group=G2) / 100
brk_buf     = input.float(0.20, "Breakout Buffer %",      minval=0.0, maxval=2.0, step=0.05, group=G2) / 100
var string G3 = "Trade"
acc_size    = input.float(5000, "Account Size $",         minval=100, group=G3)
risk_pct    = input.float(1.0,  "Risk Per Trade %",       minval=0.1, maxval=5.0, step=0.1, group=G3) / 100
var string G4 = "Display"
show_zz     = input.bool(true,  "Draw Zig-Zag",           group=G4)
show_levels = input.bool(true,  "Show Entry / SL / TP",   group=G4)
show_tbl    = input.bool(true,  "Show Stats Table",        group=G4)

// ── Zig-Zag Engine ─────────────────────────────────────────────────────────
var float run_hi      = high
var float run_lo      = low
var int   run_hi_bar  = bar_index
var int   run_lo_bar  = bar_index
var bool  seek_hi     = true

var float ph = na;  var int ph_bar = na
var float pl = na;  var int pl_bar = na

var float leg_origin = na
var float leg_pivot  = na
var bool  leg_long   = false

bool new_ph = false
bool new_pl = false

if seek_hi
    if high > run_hi
        run_hi    := high
        run_hi_bar := bar_index
    if close < run_hi * (1.0 - zz_pct)
        if show_zz and not na(pl)
            line.new(pl_bar, pl, run_hi_bar, run_hi,
                 color=color.new(color.teal, 25), width=2)
        if not na(pl)
            leg_origin := pl
            leg_pivot  := run_hi
            leg_long   := true
        ph      := run_hi;  ph_bar := run_hi_bar
        new_ph  := true
        seek_hi := false
        run_lo  := low;  run_lo_bar := bar_index
else
    if low < run_lo
        run_lo    := low
        run_lo_bar := bar_index
    if close > run_lo * (1.0 + zz_pct)
        if show_zz and not na(ph)
            line.new(ph_bar, ph, run_lo_bar, run_lo,
                 color=color.new(color.red, 25), width=2)
        if not na(ph)
            leg_origin := ph
            leg_pivot  := run_lo
            leg_long   := false
        pl      := run_lo;  pl_bar := run_lo_bar
        new_pl  := true
        seek_hi := true
        run_hi  := high;  run_hi_bar := bar_index

// Pivot labels
if show_zz
    if new_ph
        label.new(ph_bar, ph, "H", style=label.style_label_down,
             color=color.new(color.teal, 50), textcolor=color.white, size=size.small)
    if new_pl
        label.new(pl_bar, pl, "L", style=label.style_label_up,
             color=color.new(color.red, 50), textcolor=color.white, size=size.small)

// ── Frozen Setup Parameters (survive into next bar) ─────────────────────────
var float f_entry = na   // breakout level (close must clear this)
var float f_sl    = na
var float f_tp    = na
var bool  f_long  = false
var bool  pending = false   // confirmed close seen, waiting for next bar open

// Recalculate whenever a new leg is ready
if new_ph or new_pl
    if not na(leg_origin) and not na(leg_pivot)
        float rng = math.abs(leg_pivot - leg_origin)
        if leg_long
            f_entry := leg_pivot * (1.0 + brk_buf)
            f_sl    := f_entry - sl_frac * rng
            f_tp    := f_entry + tp_ext  * rng
        else
            f_entry := leg_pivot * (1.0 - brk_buf)
            f_sl    := f_entry + sl_frac * rng
            f_tp    := f_entry - tp_ext  * rng
        f_long  := leg_long
        pending := false          // reset; need fresh close confirmation

// ── Wait for Close Confirmation (v2 key rule) ────────────────────────────────
var bool confirmed    = false
var bool confirm_long = false

if not pending and not confirmed and strategy.position_size == 0 and not na(f_entry)
    if f_long  and close >= f_entry
        confirmed    := true
        confirm_long := true
    if not f_long and close <= f_entry
        confirmed    := true
        confirm_long := false

// Cancel if a new pivot fires before we entered
if (new_ph or new_pl) and strategy.position_size == 0
    confirmed := false
    pending   := false

// ── Enter Next Bar at Open (no lookahead) ────────────────────────────────────
if confirmed[1] and strategy.position_size == 0
    float entry_open  = open
    float risk_dist   = math.abs(entry_open - f_sl)
    float qty         = risk_dist > 0 ? (acc_size * risk_pct) / risk_dist : 0.001
    if confirm_long[1]
        strategy.entry("Long",  strategy.long,  qty=qty)
        strategy.exit("Long-X", "Long",  stop=f_sl, limit=f_tp)
    else
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short-X","Short", stop=f_sl, limit=f_tp)
    confirmed := false

// ── Draw Setup Levels ────────────────────────────────────────────────────────
var line  ln_entry = na
var line  ln_sl    = na
var line  ln_tp    = na

if show_levels and not na(f_entry) and strategy.position_size == 0
    line.delete(ln_entry)
    line.delete(ln_sl)
    line.delete(ln_tp)
    ln_entry := line.new(bar_index - 5, f_entry, bar_index, f_entry,
         color=color.new(color.yellow, 20), style=line.style_dotted, width=2, extend=extend.right)
    ln_sl    := line.new(bar_index - 5, f_sl, bar_index, f_sl,
         color=color.new(color.red, 20), style=line.style_dashed, width=1, extend=extend.right)
    ln_tp    := line.new(bar_index - 5, f_tp, bar_index, f_tp,
         color=color.new(color.lime, 20), style=line.style_dashed, width=1, extend=extend.right)

// ── Confirmation bar highlight ───────────────────────────────────────────────
bgcolor(confirmed and not na(f_entry) ? color.new(color.yellow, 88) : na,
     title="Confirmation Bar Highlight")

// ── Backtest Report Panel ────────────────────────────────────────────────────
if show_tbl and barstate.islast
    var table tbl = table.new(position.top_right, 2, 20,
         bgcolor=color.new(color.black, 65), border_color=color.new(color.gray, 40), border_width=1)
    float net    = strategy.netprofit
    float closed = strategy.closedtrades
    float wins   = strategy.wintrades
    float losses = strategy.losstrades
    float wr     = closed > 0 ? wins / closed * 100 : 0.0
    float gp     = strategy.grossprofit
    float gl     = strategy.grossloss
    float pf     = gl != 0 ? math.abs(gp / gl) : 0.0
    float avg_w  = wins   > 0 ? gp / wins   : 0.0
    float avg_l  = losses > 0 ? gl / losses : 0.0
    float rr     = avg_l != 0 ? math.abs(avg_w / avg_l) : 0.0
    float mdd    = strategy.max_drawdown
    float mru    = strategy.max_runup
    float best   = 0.0
    float worst  = 0.0
    if int(closed) > 0
        for i = 0 to int(closed) - 1
            float p = strategy.closedtrades.profit(i)
            if p > best
                best  := p
            if p < worst
                worst := p
    // Header
    table.cell(tbl, 0, 0, "BC-v2 Backtest Report", text_color=color.white, bgcolor=color.new(color.teal, 25), text_size=size.small)
    table.cell(tbl, 1, 0, str.tostring(zz_pct * 100, "#.0") + "% ZZ (Validated)", text_color=color.white, bgcolor=color.new(color.teal, 25), text_size=size.small)
    // Trades section
    table.cell(tbl, 0, 1, "TRADES", text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 1, 1, "",       text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 0, 2, "Total Closed", text_color=color.gray,  text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(closed, "#"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "Wins",         text_color=color.gray,  text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(wins, "#") + "  (" + str.tostring(wr, "#.1") + "%)", text_color=wr >= 45 ? color.lime : color.orange, text_size=size.small)
    table.cell(tbl, 0, 4, "Losses",       text_color=color.gray,  text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(losses, "#"), text_color=color.red, text_size=size.small)
    // P&L section
    table.cell(tbl, 0, 5, "P & L", text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 1, 5, "",      text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 0, 6, "Net P&L",       text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 6, "$" + str.tostring(net, "#.2"), text_color=net >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 7, "Gross Profit",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 7, "$" + str.tostring(gp, "#.2"), text_color=color.lime, text_size=size.small)
    table.cell(tbl, 0, 8, "Gross Loss",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 8, "$" + str.tostring(gl, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(tbl, 0, 9, "Profit Factor", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 9, str.tostring(pf, "#.2"), text_color=pf >= 1.0 ? color.lime : color.red, text_size=size.small)
    // Risk / Reward section
    table.cell(tbl, 0, 10, "RISK / REWARD", text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 1, 10, "",              text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 0, 11, "Max Drawdown",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 11, "$" + str.tostring(mdd, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(tbl, 0, 12, "Max Run-up",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 12, "$" + str.tostring(mru, "#.2"), text_color=color.lime, text_size=size.small)
    table.cell(tbl, 0, 13, "Avg Win",       text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 13, "$" + str.tostring(avg_w, "#.2"), text_color=color.lime, text_size=size.small)
    table.cell(tbl, 0, 14, "Avg Loss",      text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 14, "$" + str.tostring(avg_l, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(tbl, 0, 15, "Avg R:R",       text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 15, str.tostring(rr, "#.2") + " : 1", text_color=rr >= 1.0 ? color.lime : color.orange, text_size=size.small)
    table.cell(tbl, 0, 16, "Best / Worst",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 16, "$" + str.tostring(best, "#.2") + " / $" + str.tostring(worst, "#.2"), text_color=color.white, text_size=size.small)
    // Setup parameters section
    table.cell(tbl, 0, 17, "SETUP PARAMS",  text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 1, 17, "",              text_color=color.silver, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(tbl, 0, 18, "SL / TP Frac",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 18, str.tostring(sl_frac * 100, "#.1") + "% / " + str.tostring(tp_ext * 100, "#.1") + "%", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 19, "Next Entry",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 19, not na(f_entry) ? (f_long ? "LONG " : "SHORT ") + str.tostring(f_entry, "#.2") : "Waiting...",
         text_color=not na(f_entry) ? (f_long ? color.lime : color.red) : color.gray, text_size=size.small)

// ── Alert Conditions ─────────────────────────────────────────────────────────
alertcondition(confirmed and confirm_long,   "BC-v2 LONG Confirmed",  "BC-v2: LONG close confirmation at {{close}} — enter at next bar open")
alertcondition(confirmed and not confirm_long,"BC-v2 SHORT Confirmed", "BC-v2: SHORT close confirmation at {{close}} — enter at next bar open")
alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0, "BC-v2 LONG Filled",   "BC-v2 LONG filled at {{open}}")
alertcondition(strategy.position_size < 0 and strategy.position_size[1] == 0, "BC-v2 SHORT Filled",  "BC-v2 SHORT filled at {{open}}")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] != 0,"BC-v2 Trade Closed",  "BC-v2 trade closed — P&L: {{strategy.netprofit}}")
