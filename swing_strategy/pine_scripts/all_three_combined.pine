//@version=5
// HOW TO LOAD THIS IN TRADINGVIEW:
// 1. Open Pine Editor (bottom of screen)
// 2. Click the dropdown arrow next to "Open" -> "New script"
//    (this gives you a blank editor with just the default indicator() stub)
// 3. Select ALL (Ctrl+A on Windows, Cmd+A on Mac)
// 4. DELETE (Backspace or Delete key)
// 5. PASTE this entire file
// 6. Click "Add to chart"
//
// If you skip steps 3-4 you will get CE10243 (two declarations).
//
// BC-v1 (orange triangles) : wick-touch breakout, SL at leg origin
// BC-v2 (green/red triangles): CLOSE-confirmed entry, 61.8% SL, 161.8% TP  <-- validated
// Cycle (cyan/magenta diamonds): DFT dominant-cycle turning points
// ============================================================
indicator(title="BC-v1 v2 Cycle Signals", shorttitle="BCvCyc", overlay=true,
     max_lines_count=200, max_labels_count=200)

// ============================================================
// INPUTS
// ============================================================
i_zz1      = input.float(8.0,  "BC-v1 ZZ %",          minval=1.0, maxval=30.0, step=0.5, group="Zig-Zag") / 100
i_zz2      = input.float(5.0,  "BC-v2 ZZ % (validated)", minval=1.0, maxval=30.0, step=0.5, group="Zig-Zag") / 100
i_buf      = input.float(0.20, "Breakout Buffer %",    minval=0.0, maxval=2.0,  step=0.05, group="Zig-Zag") / 100
i_sl       = input.float(61.8, "v2 SL Giveback %",     minval=20.0, maxval=100.0, step=1.0, group="BC-v2") / 100
i_tp       = input.float(161.8,"v2 TP Extension %",    minval=100.0, maxval=300.0, step=1.0, group="BC-v2") / 100
i_fw       = input.int(120,    "Cycle Fit Window",     minval=30, maxval=300, group="Cycle DFT")
i_sma      = input.int(50,     "Cycle Detrend SMA",    minval=10, maxval=200, group="Cycle DFT")
i_minT     = input.int(10,     "Cycle Min Period",     minval=3,  maxval=50,  group="Cycle DFT")
i_maxT     = input.int(60,     "Cycle Max Period",     minval=10, maxval=200, group="Cycle DFT")
i_mom      = input.int(3,      "Cycle Momentum Bars",  minval=1,  maxval=10,  group="Cycle DFT")
i_slbuf    = input.float(2.0,  "Cycle SL Buffer %",    minval=0.1, maxval=10.0, step=0.1, group="Cycle DFT") / 100
i_tpamp    = input.float(1.0,  "Cycle TP x Amplitude", minval=0.25, maxval=5.0, step=0.25, group="Cycle DFT")
i_showzz   = input.bool(true,  "Draw Zig-Zag Lines",   group="Display")
i_showlvl  = input.bool(true,  "Show v2 Levels",       group="Display")
i_showtbl  = input.bool(true,  "Show Table",           group="Display")

// ============================================================
// ZIG-ZAG ENGINE  (two independent instances: v1 and v2 thresholds)
// Returns: new pivot flags and current leg parameters
// ============================================================

// --- v1 ZZ (8% default) ---
var float zrh1  = high
var float zrl1  = low
var int   zrhb1 = bar_index
var int   zrlb1 = bar_index
var bool  zsh1  = true
var float zph1  = na
var float zpl1  = na
var int   zphb1 = na
var int   zplb1 = na
var float zlo1  = na
var float zlp1  = na
var bool  zll1  = false
var bool  zact1 = false

bool znph1 = false
bool znpl1 = false

if zsh1
    if high > zrh1
        zrh1  := high
        zrhb1 := bar_index
    if close < zrh1 * (1.0 - i_zz1)
        if i_showzz and not na(zpl1)
            line.new(zplb1, zpl1, zrhb1, zrh1, color=color.new(color.teal, 65), width=1, style=line.style_dotted)
        if not na(zpl1)
            zlo1 := zpl1
            zlp1 := zrh1
            zll1 := true
            zact1 := true
        zph1  := zrh1
        zphb1 := zrhb1
        znph1 := true
        zsh1  := false
        zrl1  := low
        zrlb1 := bar_index
else
    if low < zrl1
        zrl1  := low
        zrlb1 := bar_index
    if close > zrl1 * (1.0 + i_zz1)
        if i_showzz and not na(zph1)
            line.new(zphb1, zph1, zrlb1, zrl1, color=color.new(color.orange, 65), width=1, style=line.style_dotted)
        if not na(zph1)
            zlo1 := zph1
            zlp1 := zrl1
            zll1 := false
            zact1 := true
        zpl1  := zrl1
        zplb1 := zrlb1
        znpl1 := true
        zsh1  := true
        zrh1  := high
        zrhb1 := bar_index

// --- v2 ZZ (5% default) ---
var float zrh2  = high
var float zrl2  = low
var int   zrhb2 = bar_index
var int   zrlb2 = bar_index
var bool  zsh2  = true
var float zph2  = na
var float zpl2  = na
var int   zphb2 = na
var int   zplb2 = na
var float zlo2  = na
var float zlp2  = na
var bool  zll2  = false

bool znph2 = false
bool znpl2 = false

if zsh2
    if high > zrh2
        zrh2  := high
        zrhb2 := bar_index
    if close < zrh2 * (1.0 - i_zz2)
        if i_showzz and not na(zpl2)
            line.new(zplb2, zpl2, zrhb2, zrh2, color=color.new(color.teal, 20), width=2)
        if not na(zpl2)
            zlo2 := zpl2
            zlp2 := zrh2
            zll2 := true
        zph2  := zrh2
        zphb2 := zrhb2
        znph2 := true
        zsh2  := false
        zrl2  := low
        zrlb2 := bar_index
else
    if low < zrl2
        zrl2  := low
        zrlb2 := bar_index
    if close > zrl2 * (1.0 + i_zz2)
        if i_showzz and not na(zph2)
            line.new(zphb2, zph2, zrlb2, zrl2, color=color.new(color.red, 20), width=2)
        if not na(zph2)
            zlo2 := zph2
            zlp2 := zrl2
            zll2 := false
        zpl2  := zrl2
        zplb2 := zrlb2
        znpl2 := true
        zsh2  := true
        zrh2  := high
        zrhb2 := bar_index

// Pivot labels on v2 ZZ
if i_showzz
    if znph2
        label.new(zphb2, zph2, "H", style=label.style_label_down,
             color=color.new(color.teal, 40), textcolor=color.white, size=size.tiny)
    if znpl2
        label.new(zplb2, zpl2, "L", style=label.style_label_up,
             color=color.new(color.red, 40), textcolor=color.white, size=size.tiny)

// ============================================================
// BC-v1 SIGNAL: wick touches breakout level
// ============================================================
var float v1e  = na
var float v1sl = na
var float v1tp = na
var bool  v1lg = false

if znph1 or znpl1
    if not na(zlo1) and not na(zlp1)
        float rng = math.abs(zlp1 - zlo1)
        if zll1
            v1e  := zlp1 * (1.0 + i_buf)
            v1sl := zlo1
            v1tp := v1e + rng
            v1lg := true
        else
            v1e  := zlp1 * (1.0 - i_buf)
            v1sl := zlo1
            v1tp := v1e - rng
            v1lg := false
        zact1 := true

bool v1_long  = zact1 and v1lg  and high >= v1e
bool v1_short = zact1 and not v1lg and low  <= v1e

if v1_long or v1_short
    zact1 := false

// ============================================================
// BC-v2 SIGNAL: close confirmation, entry at next bar open
// ============================================================
var float v2e   = na
var float v2sl  = na
var float v2tp  = na
var bool  v2lg  = false
var bool  v2cfm = false
var bool  v2cfl = false

if znph2 or znpl2
    if not na(zlo2) and not na(zlp2)
        float rng = math.abs(zlp2 - zlo2)
        if zll2
            v2e  := zlp2 * (1.0 + i_buf)
            v2sl := v2e - i_sl * rng
            v2tp := v2e + i_tp * rng
            v2lg := true
        else
            v2e  := zlp2 * (1.0 - i_buf)
            v2sl := v2e + i_sl * rng
            v2tp := v2e - i_tp * rng
            v2lg := false
        v2cfm := false

if not v2cfm and not na(v2e)
    if v2lg  and close >= v2e
        v2cfm := true
        v2cfl := true
    if not v2lg and close <= v2e
        v2cfm := true
        v2cfl := false

if znph2 or znpl2
    v2cfm := false

bool v2_long  = v2cfm[1] and v2cfl[1]
bool v2_short = v2cfm[1] and not v2cfl[1]

if v2_long or v2_short
    v2cfm := false

// Draw v2 levels
var line ln_e  = na
var line ln_sl = na
var line ln_tp = na

if i_showlvl and not na(v2e)
    line.delete(ln_e)
    line.delete(ln_sl)
    line.delete(ln_tp)
    ln_e  := line.new(bar_index - 3, v2e,  bar_index, v2e,
         color=color.new(color.yellow, 10), style=line.style_dotted, width=2, extend=extend.right)
    ln_sl := line.new(bar_index - 3, v2sl, bar_index, v2sl,
         color=color.new(color.red, 15), style=line.style_dashed, width=1, extend=extend.right)
    ln_tp := line.new(bar_index - 3, v2tp, bar_index, v2tp,
         color=color.new(color.lime, 15), style=line.style_dashed, width=1, extend=extend.right)

bgcolor(v2cfm and not na(v2e) ? color.new(color.yellow, 90) : na, title="v2 Confirm")

// ============================================================
// CYCLE DFT SIGNAL
// ============================================================
var float cT   = na
var float cAmp = na
var float cDer = na
var float cPDr = na

if barstate.isconfirmed and bar_index >= i_fw + i_sma
    float[] xt = array.new_float(i_fw, 0.0)
    for i = 0 to i_fw - 1
        array.set(xt, i, close[i] - ta.sma(close, i_sma)[i])

    float bp  = 0.0
    float bTf = float(i_minT)
    float bA  = 0.0
    float bB  = 0.0

    for T = i_minT to i_maxT
        float Tf = float(T)
        float Wf = float(i_fw)
        float aT = 0.0
        float bT = 0.0
        for t = 0 to i_fw - 1
            float ang = 2.0 * math.pi * float(t) / Tf
            float x   = array.get(xt, i_fw - 1 - t)
            aT := aT + x * math.cos(ang)
            bT := bT + x * math.sin(ang)
        aT := 2.0 * aT / Wf
        bT := 2.0 * bT / Wf
        float pw = aT * aT + bT * bT
        if pw > bp
            bp  := pw
            bTf := Tf
            bA  := aT
            bB  := bT

    float w    = 2.0 * math.pi / bTf
    float tCur = float(i_fw - 1)
    float tPrv = float(i_fw - 2)
    cT   := bTf
    cAmp := math.sqrt(bA * bA + bB * bB)
    cDer := -bA * w * math.sin(w * tCur) + bB * w * math.cos(w * tCur)
    cPDr := -bA * w * math.sin(w * tPrv) + bB * w * math.cos(w * tPrv)

var float vcT   = na
var float vcAmp = na
var float vcDer = na
var float vcPDr = na

if not na(cT)
    vcT   := cT
    vcAmp := cAmp
    vcDer := cDer
    vcPDr := cPDr

bool cy_up   = not na(vcDer) and not na(vcPDr) and vcDer >= 0.0 and vcPDr < 0.0
bool cy_down = not na(vcDer) and not na(vcPDr) and vcDer <= 0.0 and vcPDr > 0.0
bool cy_long  = cy_up   and close > close[i_mom]
bool cy_short = cy_down and close < close[i_mom]

float cy_sl_l = ta.lowest(low,   20) * (1.0 - i_slbuf)
float cy_sl_s = ta.highest(high, 20) * (1.0 + i_slbuf)
float cy_tp_l = not na(vcAmp) ? close + vcAmp * i_tpamp : na
float cy_tp_s = not na(vcAmp) ? close - vcAmp * i_tpamp : na

if barstate.islast and not na(vcT)
    label.new(bar_index, high,
         "Cycle T=" + str.tostring(vcT, "#") + "  A=" + str.tostring(vcAmp, "#.0"),
         style=label.style_label_left, color=color.new(color.navy, 50),
         textcolor=color.aqua, size=size.small)

// ============================================================
// SIGNAL SHAPES
// ============================================================
plotshape(v1_long,  "v1 Long",  shape.triangleup,   location.belowbar,
     color=color.new(color.orange, 20), size=size.small, text="v1")
plotshape(v1_short, "v1 Short", shape.triangledown, location.abovebar,
     color=color.new(color.orange, 20), size=size.small, text="v1")

plotshape(v2_long,  "v2 Long",  shape.triangleup,   location.belowbar,
     color=color.lime, size=size.normal, text="v2")
plotshape(v2_short, "v2 Short", shape.triangledown, location.abovebar,
     color=color.red,  size=size.normal, text="v2")

plotshape(cy_long,  "Cy Long",  shape.diamond, location.belowbar,
     color=color.aqua,    size=size.small, text="C")
plotshape(cy_short, "Cy Short", shape.diamond, location.abovebar,
     color=color.fuchsia, size=size.small, text="C")

// ============================================================
// INFO TABLE
// ============================================================
if i_showtbl and barstate.islast
    var table tb = table.new(position.bottom_right, 3, 8,
         bgcolor=color.new(color.black, 60),
         border_color=color.new(color.gray, 50), border_width=1)
    table.cell(tb, 0, 0, "Signal",    text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 1, 0, "Dir",       text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 2, 0, "Level",     text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 0, 1, "BC-v1",     text_color=color.orange, text_size=size.tiny)
    table.cell(tb, 1, 1, not na(v1e) ? (v1lg ? "LONG" : "SHORT") : "--",
         text_color=not na(v1e) ? (v1lg ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tb, 2, 1, not na(v1e) ? str.tostring(v1e, "#.1") : "--",
         text_color=color.white, text_size=size.tiny)
    table.cell(tb, 0, 2, "BC-v2 En",  text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 1, 2, not na(v2e) ? (v2lg ? "LONG" : "SHORT") : "--",
         text_color=not na(v2e) ? (v2lg ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tb, 2, 2, not na(v2e) ? str.tostring(v2e, "#.1") : "--",
         text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 3, "  SL",      text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 1, 3, "61.8%",     text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 2, 3, not na(v2sl) ? str.tostring(v2sl, "#.1") : "--",
         text_color=color.red,  text_size=size.tiny)
    table.cell(tb, 0, 4, "  TP",      text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 1, 4, "161.8%",    text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 2, 4, not na(v2tp) ? str.tostring(v2tp, "#.1") : "--",
         text_color=color.lime, text_size=size.tiny)
    table.cell(tb, 0, 5, "Cycle T",   text_color=color.aqua,   text_size=size.tiny)
    table.cell(tb, 1, 5, not na(vcT) ? str.tostring(vcT, "#") + " bars" : "--",
         text_color=color.aqua, text_size=size.tiny)
    table.cell(tb, 2, 5, not na(vcAmp) ? "A=" + str.tostring(vcAmp, "#.0") : "--",
         text_color=color.aqua, text_size=size.tiny)
    table.cell(tb, 0, 6, "  d/dt",    text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 1, 6, not na(vcDer) ? (vcDer >= 0.0 ? "Rising" : "Falling") : "--",
         text_color=not na(vcDer) ? (vcDer >= 0.0 ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tb, 2, 6, not na(vcDer) ? str.tostring(vcDer, "#.5") : "--",
         text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 0, 7, "Confirmed", text_color=color.gray,   text_size=size.tiny)
    table.cell(tb, 1, 7, v2cfm ? "YES" : "no",
         text_color=v2cfm ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(tb, 2, 7, v2cfm ? "Enter next open" : "--",
         text_color=color.yellow, text_size=size.tiny)

// ============================================================
// ALERTS
// ============================================================
alertcondition(v1_long,  "v1 LONG",           "BC-v1 LONG: breakout at {{close}}")
alertcondition(v1_short, "v1 SHORT",          "BC-v1 SHORT: breakout at {{close}}")
alertcondition(v2cfm and v2cfl,  "v2 LONG Confirmed",  "BC-v2 LONG confirmed at {{close}} -- enter at next open")
alertcondition(v2cfm and not v2cfl, "v2 SHORT Confirmed", "BC-v2 SHORT confirmed at {{close}} -- enter at next open")
alertcondition(v2_long,  "v2 LONG Entry",     "BC-v2 LONG entry bar now open at {{open}}")
alertcondition(v2_short, "v2 SHORT Entry",    "BC-v2 SHORT entry bar now open at {{open}}")
alertcondition(cy_long,  "Cycle LONG",        "Cycle LONG turning point at {{close}}")
alertcondition(cy_short, "Cycle SHORT",       "Cycle SHORT turning point at {{close}}")
