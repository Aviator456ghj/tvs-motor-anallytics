//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// ALL THREE SIGNALS COMBINED — BC-v1 · BC-v2 · Cycle Sine
// Paste this ONE script. One indicator() declaration, three signal layers.
//
// Strategy #3 — BC-v1  : wick-touch arrows  (orange, structural SL)
// Strategy #4 — BC-v2  : close-confirm arrows (green/red, 61.8/161.8%)
// Strategy #6 — Cycle  : DFT turning-point diamonds (cyan/magenta)
//
// For actual P&L backtesting, use bc_v2_swing_breakout.pine separately.
// ═══════════════════════════════════════════════════════════════════════════
indicator("BC-v1 · BC-v2 · Cycle Signals", shorttitle="BC123+Cyc",
     overlay=true, max_labels_count=500, max_lines_count=500)

// ════════════════════════════════════════════════════════════════════════════
// ─── INPUT GROUPS ───────────────────────────────────────────────────────────
// ════════════════════════════════════════════════════════════════════════════
var string GZ  = "Zig-Zag"
zz_pct_v1 = input.float(8.0, "BC-v1 ZZ Threshold %", minval=1.0, maxval=30.0, step=0.5, group=GZ) / 100
zz_pct_v2 = input.float(5.0, "BC-v2 ZZ Threshold %", minval=1.0, maxval=30.0, step=0.5,
     tooltip="5% is the walk-forward validated setting", group=GZ) / 100
brk_buf    = input.float(0.20, "Breakout Buffer %",  minval=0.0, maxval=2.0, step=0.05, group=GZ) / 100

var string GV  = "BC-v2 Levels"
sl_frac    = input.float(61.8, "v2 SL Giveback %",  minval=20.0, maxval=100.0, step=1.0, group=GV) / 100
tp_ext     = input.float(161.8,"v2 TP Extension %", minval=100.0, maxval=300.0, step=1.0, group=GV) / 100

var string GC  = "Cycle DFT"
fit_win    = input.int(120, "Fit Window (bars)",    minval=30,  maxval=300, group=GC)
sma_per    = input.int(50,  "Detrend SMA Period",   minval=10,  maxval=200, group=GC)
min_T      = input.int(10,  "Min Period",           minval=3,   maxval=50,  group=GC)
max_T      = input.int(60,  "Max Period",           minval=10,  maxval=200, group=GC)
mom_bars   = input.int(3,   "Momentum Lookback",    minval=1,   maxval=10,  group=GC)
sl_buf_cyc = input.float(2.0,"Cycle SL Buffer %",  minval=0.1, maxval=10.0, step=0.1, group=GC) / 100
tp_amp     = input.float(1.0,"Cycle TP × Amplitude",minval=0.25, maxval=5.0, step=0.25, group=GC)

var string GD  = "Display"
show_zz    = input.bool(true,  "Draw Zig-Zag Lines",     group=GD)
show_v2    = input.bool(true,  "Show v2 Entry/SL/TP",    group=GD)
show_cyc   = input.bool(true,  "Show Cycle Wave Label",   group=GD)
show_tbl   = input.bool(true,  "Show Info Table",         group=GD)

// ════════════════════════════════════════════════════════════════════════════
// ─── SHARED ZIG-ZAG ENGINE (runs twice: once for v1 threshold, once for v2)
// ════════════════════════════════════════════════════════════════════════════
// Pine Script functions can't capture var state cleanly in loops,
// so we unroll two independent zig-zag engines side by side.

// ── ZZ for BC-v1 (default 8%) ───────────────────────────────────────────────
var float rh1 = high;  var float rl1 = low
var int   rhb1 = bar_index;  var int rlb1 = bar_index
var bool  sh1  = true
var float ph1  = na;  var int phb1 = na
var float pl1  = na;  var int plb1 = na
var float lo1  = na;  var float lp1 = na;  var bool ll1 = false

bool nph1 = false;  bool npl1 = false

if sh1
    if high > rh1
        rh1 := high;  rhb1 := bar_index
    if close < rh1 * (1.0 - zz_pct_v1)
        if show_zz and not na(pl1)
            line.new(plb1, pl1, rhb1, rh1, color=color.new(color.teal, 50), width=1, style=line.style_dotted)
        if not na(pl1)
            lo1 := pl1;  lp1 := rh1;  ll1 := true
        ph1 := rh1;  phb1 := rhb1;  nph1 := true
        sh1 := false;  rl1 := low;  rlb1 := bar_index
else
    if low < rl1
        rl1 := low;  rlb1 := bar_index
    if close > rl1 * (1.0 + zz_pct_v1)
        if show_zz and not na(ph1)
            line.new(phb1, ph1, rlb1, rl1, color=color.new(color.orange, 50), width=1, style=line.style_dotted)
        if not na(ph1)
            lo1 := ph1;  lp1 := rl1;  ll1 := false
        pl1 := rl1;  plb1 := rlb1;  npl1 := true
        sh1 := true;  rh1 := high;  rhb1 := bar_index

// ── ZZ for BC-v2 (default 5%) ───────────────────────────────────────────────
var float rh2 = high;  var float rl2 = low
var int   rhb2 = bar_index;  var int rlb2 = bar_index
var bool  sh2  = true
var float ph2  = na;  var int phb2 = na
var float pl2  = na;  var int plb2 = na
var float lo2  = na;  var float lp2 = na;  var bool ll2 = false

bool nph2 = false;  bool npl2 = false

if sh2
    if high > rh2
        rh2 := high;  rhb2 := bar_index
    if close < rh2 * (1.0 - zz_pct_v2)
        if show_zz and not na(pl2)
            line.new(plb2, pl2, rhb2, rh2, color=color.new(color.teal, 20), width=2)
        if not na(pl2)
            lo2 := pl2;  lp2 := rh2;  ll2 := true
        ph2 := rh2;  phb2 := rhb2;  nph2 := true
        sh2 := false;  rl2 := low;  rlb2 := bar_index
else
    if low < rl2
        rl2 := low;  rlb2 := bar_index
    if close > rl2 * (1.0 + zz_pct_v2)
        if show_zz and not na(ph2)
            line.new(phb2, ph2, rlb2, rl2, color=color.new(color.red, 20), width=2)
        if not na(ph2)
            lo2 := ph2;  lp2 := rl2;  ll2 := false
        pl2 := rl2;  plb2 := rlb2;  npl2 := true
        sh2 := true;  rh2 := high;  rhb2 := bar_index

// Pivot labels on v2 ZZ
if show_zz
    if nph2
        label.new(phb2, ph2, "H", style=label.style_label_down,
             color=color.new(color.teal, 40), textcolor=color.white, size=size.tiny)
    if npl2
        label.new(plb2, pl2, "L", style=label.style_label_up,
             color=color.new(color.red, 40), textcolor=color.white, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// ─── BC-v1 SIGNAL : wick touches breakout level
// ════════════════════════════════════════════════════════════════════════════
var float v1_entry = na;  var float v1_sl = na;  var float v1_tp = na
var bool  v1_long  = false;  var bool v1_active = false

if nph1 or npl1
    if not na(lo1) and not na(lp1)
        float rng = math.abs(lp1 - lo1)
        if ll1
            v1_entry := lp1 * (1.0 + brk_buf)
            v1_sl    := lo1
            v1_tp    := v1_entry + rng
            v1_long  := true
        else
            v1_entry := lp1 * (1.0 - brk_buf)
            v1_sl    := lo1
            v1_tp    := v1_entry - rng
            v1_long  := false
        v1_active := true

// Fire on wick touch (v1 rule)
bool v1_long_sig  = v1_active and v1_long  and high >= v1_entry
bool v1_short_sig = v1_active and not v1_long and low <= v1_entry

if v1_long_sig or v1_short_sig
    v1_active := false   // one shot per leg

// Cancel on new pivot
if nph1 or npl1
    v1_active := true   // re-arm only after we compute the new setup above

// ════════════════════════════════════════════════════════════════════════════
// ─── BC-v2 SIGNAL : CLOSE confirmation → entry at next bar open
// ════════════════════════════════════════════════════════════════════════════
var float v2_entry = na;  var float v2_sl = na;  var float v2_tp = na
var bool  v2_long  = false;  var bool v2_wait = false

if nph2 or npl2
    if not na(lo2) and not na(lp2)
        float rng = math.abs(lp2 - lo2)
        if ll2
            v2_entry := lp2 * (1.0 + brk_buf)
            v2_sl    := v2_entry - sl_frac * rng
            v2_tp    := v2_entry + tp_ext  * rng
            v2_long  := true
        else
            v2_entry := lp2 * (1.0 - brk_buf)
            v2_sl    := v2_entry + sl_frac * rng
            v2_tp    := v2_entry - tp_ext  * rng
            v2_long  := false
        v2_wait := false  // need fresh confirmation

// Close confirmation check
var bool v2_confirmed = false
var bool v2_conf_long = false

if not v2_confirmed and not na(v2_entry)
    if v2_long  and close >= v2_entry
        v2_confirmed := true;  v2_conf_long := true
    if not v2_long and close <= v2_entry
        v2_confirmed := true;  v2_conf_long := false

// Cancel on new pivot
if nph2 or npl2
    v2_confirmed := false

// Actual signal fires on next bar's open (simulated here as signal on the open bar)
bool v2_long_sig  = v2_confirmed[1] and v2_conf_long[1]
bool v2_short_sig = v2_confirmed[1] and not v2_conf_long[1]

if v2_long_sig or v2_short_sig
    v2_confirmed := false

// ── Draw v2 setup levels ─────────────────────────────────────────────────────
var line ln_en = na;  var line ln_sl2 = na;  var line ln_tp2 = na

if show_v2 and not na(v2_entry)
    line.delete(ln_en);  line.delete(ln_sl2);  line.delete(ln_tp2)
    ln_en  := line.new(bar_index - 3, v2_entry, bar_index, v2_entry,
         color=color.new(color.yellow, 10), style=line.style_dotted, width=2, extend=extend.right)
    ln_sl2 := line.new(bar_index - 3, v2_sl, bar_index, v2_sl,
         color=color.new(color.red, 15), style=line.style_dashed, width=1, extend=extend.right)
    ln_tp2 := line.new(bar_index - 3, v2_tp, bar_index, v2_tp,
         color=color.new(color.lime, 15), style=line.style_dashed, width=1, extend=extend.right)

// Confirmation bar highlight
bgcolor(v2_confirmed and not na(v2_entry) ? color.new(color.yellow, 90) : na,
     title="v2 Confirmation Bar")

// ════════════════════════════════════════════════════════════════════════════
// ─── CYCLE / DFT SIGNAL
// ════════════════════════════════════════════════════════════════════════════
float cy_T     = na;  float cy_amp = na
float cy_deriv = na;  float cy_prev_deriv = na

if barstate.isconfirmed and bar_index >= fit_win + sma_per
    float[] xt = array.new_float(fit_win, 0.0)
    for i = 0 to fit_win - 1
        array.set(xt, i, close[i] - ta.sma(close, sma_per)[i])

    float bp = 0.0;  float bT = float(min_T);  float ba = 0.0;  float bb = 0.0
    for T = min_T to max_T
        float aT = 0.0;  float bT2 = 0.0
        float Tf = float(T);  float Wf = float(fit_win)
        for t = 0 to fit_win - 1
            float angle = 2.0 * math.pi * float(t) / Tf
            float x     = array.get(xt, fit_win - 1 - t)
            aT += x * math.cos(angle)
            bT2 += x * math.sin(angle)
        aT := 2.0 * aT / Wf;  bT2 := 2.0 * bT2 / Wf
        float pw = aT * aT + bT2 * bT2
        if pw > bp
            bp := pw;  bT := Tf;  ba := aT;  bb := bT2

    cy_T   := bT
    cy_amp := math.sqrt(ba * ba + bb * bb)
    float w = 2.0 * math.pi / bT
    cy_deriv      := -ba * w * math.sin(w * float(fit_win - 1)) + bb * w * math.cos(w * float(fit_win - 1))
    cy_prev_deriv := -ba * w * math.sin(w * float(fit_win - 2)) + bb * w * math.cos(w * float(fit_win - 2))

var float vT  = na;  var float vAmp = na
var float vD  = na;  var float vPD  = na

if not na(cy_T)
    vT  := cy_T;  vAmp := cy_amp;  vD := cy_deriv;  vPD := cy_prev_deriv

bool cy_cross_up   = not na(vD) and not na(vPD) and vD >= 0 and vPD < 0
bool cy_cross_down = not na(vD) and not na(vPD) and vD <= 0 and vPD > 0
bool cy_long  = cy_cross_up   and close > close[mom_bars]
bool cy_short = cy_cross_down and close < close[mom_bars]

float cy_sl_l = ta.lowest(low,  20) * (1.0 - sl_buf_cyc)
float cy_sl_s = ta.highest(high, 20) * (1.0 + sl_buf_cyc)
float cy_tp_l = not na(vAmp) ? close + vAmp * tp_amp : na
float cy_tp_s = not na(vAmp) ? close - vAmp * tp_amp : na

// Cycle dominant period label
if show_cyc and barstate.islast and not na(vT)
    label.new(bar_index, high * 1.002,
         "Cycle T=" + str.tostring(vT, "#") + "b  A=" + str.tostring(vAmp, "#.0"),
         style=label.style_label_down, color=color.new(color.navy, 50),
         textcolor=color.aqua, size=size.small)

// ════════════════════════════════════════════════════════════════════════════
// ─── SIGNAL SHAPES ON CHART
// ════════════════════════════════════════════════════════════════════════════
// BC-v1 signals (orange, hollow)
plotshape(v1_long_sig,  "v1 LONG",  shape.triangleup,   location.belowbar,
     color=color.new(color.orange, 20), size=size.small, text="v1")
plotshape(v1_short_sig, "v1 SHORT", shape.triangledown, location.abovebar,
     color=color.new(color.orange, 20), size=size.small, text="v1")

// BC-v2 signals (green/red, filled — the validated one)
plotshape(v2_long_sig,  "v2 LONG",  shape.triangleup,   location.belowbar,
     color=color.new(color.lime, 0), size=size.normal, text="v2 ▲", textcolor=color.lime)
plotshape(v2_short_sig, "v2 SHORT", shape.triangledown, location.abovebar,
     color=color.new(color.red, 0),  size=size.normal, text="v2 ▼", textcolor=color.red)

// Cycle signals (cyan/magenta, diamonds)
plotshape(cy_long,  "Cyc LONG",  shape.diamond, location.belowbar,
     color=color.new(color.aqua,    0), size=size.small, text="⊕", textcolor=color.aqua)
plotshape(cy_short, "Cyc SHORT", shape.diamond, location.abovebar,
     color=color.new(color.fuchsia, 0), size=size.small, text="⊖", textcolor=color.fuchsia)

// ════════════════════════════════════════════════════════════════════════════
// ─── INFO TABLE
// ════════════════════════════════════════════════════════════════════════════
if show_tbl and barstate.islast
    var table tbl = table.new(position.bottom_right, 3, 7,
         bgcolor=color.new(color.black, 60), border_color=color.new(color.gray, 50), border_width=1,
         frame_color=color.new(color.gray, 30), frame_width=1)

    // Header
    table.cell(tbl, 0, 0, "Signal",    text_color=color.gray,   text_size=size.tiny, bgcolor=color.new(color.black, 40))
    table.cell(tbl, 1, 0, "Direction", text_color=color.gray,   text_size=size.tiny, bgcolor=color.new(color.black, 40))
    table.cell(tbl, 2, 0, "Level",     text_color=color.gray,   text_size=size.tiny, bgcolor=color.new(color.black, 40))

    // BC-v1 row
    table.cell(tbl, 0, 1, "BC-v1 " + str.tostring(zz_pct_v1 * 100, "#") + "%",
         text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 1, 1, not na(v1_entry) ? (v1_long ? "LONG▲" : "SHORT▼") : "—",
         text_color=not na(v1_entry) ? (v1_long ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 1, not na(v1_entry) ? str.tostring(v1_entry, "#.1") : "—",
         text_color=color.white, text_size=size.tiny)

    // BC-v2 Entry row
    table.cell(tbl, 0, 2, "BC-v2 " + str.tostring(zz_pct_v2 * 100, "#") + "%",
         text_color=color.yellow, text_size=size.tiny)
    table.cell(tbl, 1, 2, not na(v2_entry) ? (v2_long ? "LONG▲" : "SHORT▼") : "—",
         text_color=not na(v2_entry) ? (v2_long ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 2, not na(v2_entry) ? str.tostring(v2_entry, "#.1") : "—",
         text_color=color.yellow, text_size=size.tiny)

    // BC-v2 SL row
    table.cell(tbl, 0, 3, "  SL", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, "61.8% back", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 3, not na(v2_sl) ? str.tostring(v2_sl, "#.1") : "—",
         text_color=color.red, text_size=size.tiny)

    // BC-v2 TP row
    table.cell(tbl, 0, 4, "  TP", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, "161.8% ext", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 4, not na(v2_tp) ? str.tostring(v2_tp, "#.1") : "—",
         text_color=color.lime, text_size=size.tiny)

    // Cycle row
    table.cell(tbl, 0, 5, "Cycle DFT", text_color=color.aqua, text_size=size.tiny)
    table.cell(tbl, 1, 5, not na(vT) ? "T=" + str.tostring(vT, "#") + "b" : "—",
         text_color=color.aqua, text_size=size.tiny)
    table.cell(tbl, 2, 5, not na(vAmp) ? "A=" + str.tostring(vAmp, "#.0") : "—",
         text_color=color.aqua, text_size=size.tiny)

    // Cycle deriv
    table.cell(tbl, 0, 6, "  d/dt", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, not na(vD) ? (vD >= 0 ? "↑ rising" : "↓ falling") : "—",
         text_color=not na(vD) ? (vD >= 0 ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(tbl, 2, 6, not na(vD) ? str.tostring(vD, "#.4") : "—",
         text_color=color.gray, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// ─── ALERT CONDITIONS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(v1_long_sig,  "v1 LONG",         "BC-v1 LONG entry — price hit breakout at {{close}}")
alertcondition(v1_short_sig, "v1 SHORT",        "BC-v1 SHORT entry — price hit breakout at {{close}}")
alertcondition(v2_confirmed and v2_conf_long,   "v2 LONG Confirmed",  "BC-v2 LONG confirmed close at {{close}} — BUY at next bar open")
alertcondition(v2_confirmed and not v2_conf_long,"v2 SHORT Confirmed","BC-v2 SHORT confirmed close at {{close}} — SELL at next bar open")
alertcondition(v2_long_sig,  "v2 LONG Entry",   "BC-v2 LONG entry bar open now at {{open}}")
alertcondition(v2_short_sig, "v2 SHORT Entry",  "BC-v2 SHORT entry bar open now at {{open}}")
alertcondition(cy_long,      "Cycle LONG",      "Cycle: LONG turning point at {{close}}  T=" + str.tostring(vT, "#") + " A=" + str.tostring(vAmp, "#.0"))
alertcondition(cy_short,     "Cycle SHORT",     "Cycle: SHORT turning point at {{close}}  T=" + str.tostring(vT, "#") + " A=" + str.tostring(vAmp, "#.0"))
