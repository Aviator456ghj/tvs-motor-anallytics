# ============================================================
# Copy this file to ".env" and fill in your real credentials.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# ---- Zerodha Kite ----
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Generated daily after login flow (see docs). Optional if using auto-login.
KITE_ACCESS_TOKEN=

# ---- Delta Exchange India ----
# Generate a NEW key/secret in the Delta dashboard (the old ones were leaked).
DELTA_API_KEY=your_delta_api_key
DELTA_API_SECRET=your_delta_api_secret
# India endpoint
DELTA_BASE_URL=https://api.india.delta.exchange

# ---- Global safety switch ----
# paper  = simulate orders, no real money (DEFAULT, recommended)
# live   = send real orders to the broker
TRADING_MODE=paper
