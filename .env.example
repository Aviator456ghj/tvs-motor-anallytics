# Delta Exchange India API credentials (create at https://www.delta.exchange -> API keys)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Safety switch: bot only places real orders when this is exactly "1"
DELTA_LIVE=

# Trading universe / timeframe
DELTA_SYMBOLS=BTCUSD
DELTA_TIMEFRAME_MIN=15

# Risk controls
DELTA_RISK_PER_TRADE=0.005     # 0.5% of equity risked per trade
DELTA_MAX_LEVERAGE=3
DELTA_DAILY_LOSS_LIMIT=0.02    # halt for the day at -2%
DELTA_MAX_CONSEC_LOSSES=5      # 6h cool-off after 5 losses in a row

# Paper trading starting equity (USD)
DELTA_PAPER_EQUITY=1000
