//@version=6

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║   CHoCH BIAS STRATEGY PRO  ·  Pine Script v6  ·  STRATEGY              ║
// ║   Change of Character  ·  Structural Swing Analysis  ·  V1 / V2 / V3  ║
// ║                                                                         ║
// ║   Back-tested on BTC/USDT (Crypto.com REST, 2020–2026):                ║
// ║     V1  ADX>20, expiry=10, min_swing=1   →  ~65% WR, $1→$31 (1D)      ║
// ║     V2  ADX>25, expiry=4,  min_swing=2   →  ~75% WR, best Sharpe      ║
// ║     V3  V2 + rejection + RSI side + early exit  →  lowest MaxDD       ║
// ║                                                                         ║
// ║   TradingView will draw ALL trade visuals automatically:                ║
// ║     • Long (▲) and Short (▼) entry markers per trade                   ║
// ║     • Green / red filled position band between entry and exit           ║
// ║     • Exit markers with TP / SL / CHoCH labels                         ║
// ║     • Full Strategy Tester panel: WR, PnL, MaxDD, Sharpe, etc.         ║
// ╚══════════════════════════════════════════════════════════════════════════╝

strategy("CHoCH Bias Pro [v6]",
         shorttitle              = "CHoCH Pro",
         overlay                 = true,
         initial_capital         = 10000,
         currency                = currency.USD,
         default_qty_type        = strategy.percent_of_equity,
         default_qty_value       = 100,
         commission_type         = strategy.commission.percent,
         commission_value        = 0.05,
         slippage                = 2,
         pyramiding              = 0,
         calc_on_every_tick      = false,
         process_orders_on_close = false,
         max_lines_count         = 500,
         max_labels_count        = 500,
         max_boxes_count         = 200,
         max_polylines_count     = 20)

// ══════════════════════════════════════════════════════════════════
//  §1  I N P U T S
// ══════════════════════════════════════════════════════════════════
G_RISK = "💰 Capital & Risk"
G_SW   = "⚡ Swing & Entry"
G_FLT  = "🔧 Filters"
G_VIS  = "🎨 Visuals"
G_DASH = "📊 Dashboard"

// — Capital & Risk —
i_pos_pct   = input.float(100,  "Position Size (% of Equity)",    minval=1, maxval=100, step=1, group=G_RISK,
                           tooltip="100 = full compounding. Reduce to limit per-trade exposure.")
i_comm      = input.float(0.05, "Commission per side (%)",         minval=0, maxval=1.0, step=0.01, group=G_RISK)
i_slip      = input.int  (2,    "Slippage (ticks)",                minval=0, maxval=20,  group=G_RISK)

// — Swing & Entry —
i_swing_n  = input.int  (5,    "Swing Lookback (bars each side)", minval=2, maxval=20, group=G_SW)
i_mult     = input.float(2.6,  "Entry Multiplier",                minval=1.0, maxval=10.0, step=0.1, group=G_SW,
                          tooltip="LONG entry = HL + (HH−HL) / mult  ≈ 38.5% up when 2.6")
i_stop_pct = input.float(0.5,  "Stop Buffer %",                   minval=0.0, maxval=3.0, step=0.1, group=G_SW) / 100
i_tol      = input.float(0.1,  "Level Tolerance %",               minval=0.0, maxval=1.0, step=0.05, group=G_SW) / 100
i_tp_rr    = input.float(2.0,  "Take-Profit R:R",                 minval=0.5, maxval=20.0, step=0.5, group=G_SW)

// — Filters —
i_variant  = input.string("V2", "Strategy Variant", options=["V1","V2","V3"], group=G_FLT,
                           tooltip="V1 = ADX>20, expiry=10, min_swing=1\nV2 = ADX>25, expiry=4, min_swing=2\nV3 = V2 + rejection candle + RSI side + early exit")
i_adx_thr  = input.int  (25,   "ADX Threshold (V2/V3 override)",  minval=5,  maxval=60, group=G_FLT)
i_adx_p    = input.int  (14,   "ADX Period",                      minval=5,  maxval=30, group=G_FLT)
i_expiry   = input.int  (4,    "Signal Expiry (bars)",            minval=1,  maxval=30, group=G_FLT)
i_min_sw   = input.int  (2,    "Min Swings Before Entry",         minval=1,  maxval=10, group=G_FLT)
i_rsi_p    = input.int  (14,   "RSI Period",                      minval=5,  maxval=30, group=G_FLT)

// — Variant-resolved parameters —
v_adx_thr = i_variant == "V1" ? 20 : i_adx_thr
v_expiry  = i_variant == "V1" ? 10 : i_expiry
v_min_sw  = i_variant == "V1" ? 1  : i_min_sw
v_reject  = i_variant == "V3"   // Entry candle must close beyond the entry level
v_rsi_side= i_variant == "V3"   // RSI > 50 for LONG, RSI < 50 for SHORT
v_early   = i_variant == "V3"   // Close if next candle has no follow-through

// — Visuals —
i_sw_lbl   = input.bool(true,  "Swing Labels (HH / HL / LH / LL)", group=G_VIS)
i_sw_line  = input.bool(true,  "Structural Swing Polyline",          group=G_VIS)
i_zone_box = input.bool(true,  "Signal Entry Zone Box",              group=G_VIS)
i_choch_v  = input.bool(true,  "CHoCH Markers",                     group=G_VIS)
i_bg_v     = input.bool(true,  "Bias Background Shading",            group=G_VIS)
i_bar_col  = input.bool(true,  "Colour Bars While In Trade",         group=G_VIS)

i_dash     = input.bool  (true,          "Show Dashboard",   group=G_DASH)
i_dash_pos = input.string("Bottom Right","Dashboard Position",
             options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=G_DASH)

// ══════════════════════════════════════════════════════════════════
//  §2  I N D I C A T O R S
// ══════════════════════════════════════════════════════════════════

// ADX — Wilder RMA (matches the Python backtest formula)
_up    = ta.change(high)
_dn    = -ta.change(low)
_pdm   = (_up > _dn and _up > 0) ? _up : 0.0
_ndm   = (_dn > _up and _dn > 0) ? _dn : 0.0
_tr    = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
_atrw  = ta.rma(_tr,  i_adx_p)
_pdi   = 100.0 * ta.rma(_pdm, i_adx_p) / _atrw
_ndi   = 100.0 * ta.rma(_ndm, i_adx_p) / _atrw
_dsum  = _pdi + _ndi
_dx    = _dsum > 0 ? 100.0 * math.abs(_pdi - _ndi) / _dsum : 0.0
ADX    = ta.rma(_dx, i_adx_p)

// RSI and ATR
RSI    = ta.rsi(close, i_rsi_p)
ATR    = ta.atr(14)

// ══════════════════════════════════════════════════════════════════
//  §3  PIVOT DETECTION  — fires i_swing_n bars late
// ══════════════════════════════════════════════════════════════════
ph_raw    = ta.pivothigh(high, i_swing_n, i_swing_n)
pl_raw    = ta.pivotlow (low,  i_swing_n, i_swing_n)
is_ph     = not na(ph_raw)
is_pl     = not na(pl_raw)
pivot_bar = bar_index[i_swing_n]   // the actual structural bar (lagged)

// ══════════════════════════════════════════════════════════════════
//  §4  TREND STATE  (persistent var)
// ══════════════════════════════════════════════════════════════════
var string BIAS      = "NEUTRAL"
var int    trend_cnt = 0

var float HH_p = na; var int HH_b = na
var float HL_p = na; var int HL_b = na
var float LH_p = na; var int LH_b = na
var float LL_p = na; var int LL_b = na

// Alternating sequence gate
var string last_type = "NONE"
var float  last_H_p  = na; var int last_H_b = na
var float  last_L_p  = na; var int last_L_b = na

// ══════════════════════════════════════════════════════════════════
//  §5  SIGNAL STATE
// ══════════════════════════════════════════════════════════════════
var string SIG_DIR   = na
var float  SIG_ENTRY = na
var float  SIG_STOP  = na
var float  SIG_TP    = na   // pre-computed TP for strategy.exit()
var int    SIG_ARMED = na
var bool   SIG_CONF  = false
var int    SIG_SW    = 0

// ══════════════════════════════════════════════════════════════════
//  §6  TRADE TRACKING  (mirrors strategy position for local gating)
// ══════════════════════════════════════════════════════════════════
var bool   IN_TRADE  = false
var string TR_DIR    = na
var float  TR_ENTRY  = na
var float  TR_STOP   = na
var float  TR_TP     = na

// Polyline for swing structure
var array<chart.point> sw_pts  = array.new<chart.point>()
var polyline           sw_poly = na

// Dashboard table
var table DASH = na

// Signal zone box
var box SIG_BOX = na

// ══════════════════════════════════════════════════════════════════
//  §7  HELPER FUNCTIONS (pure — no side effects on outer vars)
// ══════════════════════════════════════════════════════════════════

calc_long(float hh, float hl) =>
    rng   = hh - hl
    entry = hl + rng / i_mult
    stop  = hl * (1.0 - i_stop_pct)
    risk  = math.abs(entry - stop)
    tp    = entry + risk * i_tp_rr
    [entry, stop, tp]

calc_short(float lh, float ll) =>
    rng   = lh - ll
    entry = lh - rng / i_mult
    stop  = lh * (1.0 + i_stop_pct)
    risk  = math.abs(stop - entry)
    tp    = entry - risk * i_tp_rr
    [entry, stop, tp]

arm_long_sig(float hh, float hl, int at, int sw) =>
    [e, s, t] = calc_long(hh, hl)
    [e, s, t, "LONG", at, sw]

arm_short_sig(float lh, float ll, int at, int sw) =>
    [e, s, t] = calc_short(lh, ll)
    [e, s, t, "SHORT", at, sw]

dash_row(table t, int r, string lbl, string val, color vc) =>
    table.cell(t, 0, r, lbl, text_color=color.new(color.silver, 15),
               text_size=size.small, bgcolor=color.new(color.black, 62),
               text_halign=text.align_left)
    table.cell(t, 1, r, val, text_color=vc,
               text_size=size.small, bgcolor=color.new(color.black, 62),
               text_halign=text.align_right)

// ══════════════════════════════════════════════════════════════════
//  §8  SYNC trade state at bar open
//      strategy.position_size reflects fills from PREVIOUS bar
// ══════════════════════════════════════════════════════════════════
if IN_TRADE and strategy.position_size == 0
    IN_TRADE := false    // TP / SL was hit on previous bar by the engine

// ══════════════════════════════════════════════════════════════════
//  §9  PROCESS PIVOT HIGH
// ══════════════════════════════════════════════════════════════════
if is_ph
    ph_p = ph_raw
    ph_b = pivot_bar

    is_new_h = last_type != "H"
    if last_type == "H"
        if ph_p > last_H_p
            last_H_p := ph_p; last_H_b := ph_b
    else
        last_H_p := ph_p; last_H_b := ph_b; last_type := "H"

    if is_new_h
        if BIAS == "NEUTRAL"
            if na(HH_p) or ph_p >= HH_p * (1.0 - i_tol)
                HH_p := ph_p; HH_b := ph_b
                if not na(HL_p)
                    BIAS := "UPTREND"; trend_cnt := 1
                    if not IN_TRADE
                        [e, s, t, d, at, sw] = arm_long_sig(HH_p, HL_p, ph_b, trend_cnt)
                        SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                        SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw

        else if BIAS == "UPTREND"
            if ph_p >= HH_p * (1.0 - i_tol)
                HH_p := ph_p; HH_b := ph_b; trend_cnt += 1
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE and not na(HL_p)
                    [e, s, t, d, at, sw] = arm_long_sig(HH_p, HL_p, ph_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw
            else
                LH_p := ph_p; LH_b := ph_b

        else if BIAS == "DOWNTREND"
            if not na(LH_p) and ph_p > LH_p * (1.0 + i_tol)
                BIAS := "UPTREND"; trend_cnt := 1
                HH_p := ph_p; HH_b := ph_b
                HL_p := LL_p; HL_b := LL_b
                LH_p := na;   LL_p := na
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE and not na(HL_p)
                    [e, s, t, d, at, sw] = arm_long_sig(HH_p, HL_p, ph_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw
            else
                LH_p := ph_p; LH_b := ph_b; trend_cnt += 1
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE and not na(LL_p)
                    [e, s, t, d, at, sw] = arm_short_sig(LH_p, LL_p, ph_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw

    if i_sw_line
        sw_pts.push(chart.point.from_index(ph_b, ph_p))

// ══════════════════════════════════════════════════════════════════
//  §10  PROCESS PIVOT LOW
// ══════════════════════════════════════════════════════════════════
if is_pl
    pl_p = pl_raw
    pl_b = pivot_bar

    is_new_l = last_type != "L"
    if last_type == "L"
        if pl_p < last_L_p
            last_L_p := pl_p; last_L_b := pl_b
    else
        last_L_p := pl_p; last_L_b := pl_b; last_type := "L"

    if is_new_l
        if BIAS == "NEUTRAL"
            if na(HL_p) or pl_p < HL_p
                HL_p := pl_p; HL_b := pl_b
                if not na(HH_p) and pl_p < HH_p
                    BIAS := "DOWNTREND"; trend_cnt := 1
                    LL_p := pl_p; LL_b := pl_b
                    LH_p := HH_p; LH_b := HH_b
                    SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                    if not IN_TRADE
                        [e, s, t, d, at, sw] = arm_short_sig(LH_p, LL_p, pl_b, trend_cnt)
                        SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                        SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw

        else if BIAS == "UPTREND"
            if na(HL_p) or pl_p >= HL_p * (1.0 - i_tol)
                HL_p := pl_p; HL_b := pl_b; trend_cnt += 1
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE and not na(HH_p)
                    [e, s, t, d, at, sw] = arm_long_sig(HH_p, HL_p, pl_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw
            else
                // Lower low = swing CHoCH → bear flip
                BIAS := "DOWNTREND"; trend_cnt := 1
                LL_p := pl_p; LL_b := pl_b
                LH_p := HH_p; LH_b := HH_b
                HH_p := na;   HL_p := na
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE
                    [e, s, t, d, at, sw] = arm_short_sig(LH_p, LL_p, pl_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw

        else if BIAS == "DOWNTREND"
            if pl_p <= LL_p * (1.0 + i_tol)
                LL_p := pl_p; LL_b := pl_b; trend_cnt += 1
                SIG_DIR := na; SIG_ARMED := na; SIG_CONF := false
                if not IN_TRADE
                    [e, s, t, d, at, sw] = arm_short_sig(LH_p, LL_p, pl_b, trend_cnt)
                    SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
                    SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw
            else
                HL_p := pl_p; HL_b := pl_b

    if i_sw_line
        sw_pts.push(chart.point.from_index(pl_b, pl_p))

// Rebuild structural polyline on new pivot
if i_sw_line and (is_ph or is_pl) and sw_pts.size() >= 2
    while sw_pts.size() > 60
        sw_pts.shift()
    if not na(sw_poly)
        polyline.delete(sw_poly)
    _sc     = BIAS == "UPTREND"   ? color.new(color.teal, 15) :
              BIAS == "DOWNTREND" ? color.new(color.red,  15) : color.new(color.gray, 40)
    sw_poly := polyline.new(sw_pts, curved=false, closed=false, line_color=_sc, line_width=2)

// ══════════════════════════════════════════════════════════════════
//  §11  CLOSE-BASED  CHoCH  (real-time, intra-swing)
// ══════════════════════════════════════════════════════════════════
choch_dn = false
choch_up = false

if BIAS == "UPTREND" and not na(HL_p) and close < HL_p * (1.0 - i_tol)
    choch_dn  := true
    BIAS      := "DOWNTREND"; trend_cnt := 1
    LH_p      := na(HH_p) ? LH_p : HH_p
    LH_b      := na(HH_p) ? LH_b : HH_b
    LL_p      := na; LL_b := na
    HH_p      := na; HL_p := na
    SIG_DIR   := na; SIG_ARMED := na; SIG_CONF := false
    // Can't arm short yet — no confirmed LL from the flip bar alone

else if BIAS == "DOWNTREND" and not na(LH_p) and close > LH_p * (1.0 + i_tol)
    choch_up  := true
    BIAS      := "UPTREND"; trend_cnt := 1
    HH_p      := LH_p; HH_b := LH_b   // approximate
    HL_p      := LL_p; HL_b := LL_b
    LH_p      := na;   LL_p := na
    SIG_DIR   := na; SIG_ARMED := na; SIG_CONF := false
    if not IN_TRADE and not na(HL_p) and HH_p > HL_p
        [e, s, t, d, at, sw] = arm_long_sig(HH_p, HL_p, bar_index, trend_cnt)
        SIG_ENTRY := e; SIG_STOP := s; SIG_TP := t
        SIG_DIR := d; SIG_ARMED := at; SIG_CONF := false; SIG_SW := sw

// ══════════════════════════════════════════════════════════════════
//  §12  SIGNAL  MANAGEMENT
// ══════════════════════════════════════════════════════════════════

// Expiry
if not na(SIG_DIR) and not na(SIG_ARMED) and (bar_index - SIG_ARMED) > v_expiry
    SIG_DIR := na; SIG_ENTRY := na; SIG_STOP := na; SIG_TP := na
    SIG_ARMED := na; SIG_CONF := false; SIG_SW := 0
    box.delete(SIG_BOX)

// Confirmation (price must trade beyond entry at least once before fill)
if not na(SIG_DIR) and not IN_TRADE
    if SIG_DIR == "LONG"  and close > SIG_ENTRY
        SIG_CONF := true
    if SIG_DIR == "SHORT" and close < SIG_ENTRY
        SIG_CONF := true

// ══════════════════════════════════════════════════════════════════
//  §13  ENTRY  FILTERS  &  TRIGGER
// ══════════════════════════════════════════════════════════════════
adx_ok   = ADX > v_adx_thr
rsi_chk  = SIG_DIR == "LONG" ? RSI > 50 : RSI < 50
rsi_ok   = v_rsi_side ? rsi_chk : true
filt_ok  = adx_ok and SIG_CONF and SIG_SW >= v_min_sw and rsi_ok and not IN_TRADE and not na(SIG_DIR)

entry_long  = filt_ok and SIG_DIR == "LONG"  and low  <= SIG_ENTRY
entry_short = filt_ok and SIG_DIR == "SHORT" and high >= SIG_ENTRY

// V3 rejection: candle must close back beyond the entry level
if v_reject
    entry_long  := entry_long  and close > SIG_ENTRY
    entry_short := entry_short and close < SIG_ENTRY

// ══════════════════════════════════════════════════════════════════
//  §14  OPEN  TRADE  —  strategy.entry() + strategy.exit()
// ══════════════════════════════════════════════════════════════════
if entry_long
    // Store levels used for this trade (signal vars clear after entry)
    TR_DIR   := "LONG"
    TR_ENTRY := SIG_ENTRY
    TR_STOP  := SIG_STOP
    TR_TP    := SIG_TP
    IN_TRADE := true

    strategy.entry("Long", strategy.long, comment="▲ CHoCH Long")
    strategy.exit("Long Exit",
                  from_entry    = "Long",
                  stop          = SIG_STOP,
                  limit         = SIG_TP,
                  comment_loss  = "▼ Stop Loss",
                  comment_profit= "✔ Take Profit")

    // Clear signal
    SIG_DIR := na; SIG_ENTRY := na; SIG_STOP := na; SIG_TP := na
    SIG_ARMED := na; SIG_CONF := false; SIG_SW := 0
    box.delete(SIG_BOX)

if entry_short
    TR_DIR   := "SHORT"
    TR_ENTRY := SIG_ENTRY
    TR_STOP  := SIG_STOP
    TR_TP    := SIG_TP
    IN_TRADE := true

    strategy.entry("Short", strategy.short, comment="▼ CHoCH Short")
    strategy.exit("Short Exit",
                  from_entry    = "Short",
                  stop          = SIG_STOP,
                  limit         = SIG_TP,
                  comment_loss  = "▲ Stop Loss",
                  comment_profit= "✔ Take Profit")

    SIG_DIR := na; SIG_ENTRY := na; SIG_STOP := na; SIG_TP := na
    SIG_ARMED := na; SIG_CONF := false; SIG_SW := 0
    box.delete(SIG_BOX)

// ══════════════════════════════════════════════════════════════════
//  §15  CLOSE  TRADE  —  Early exit / CHoCH flip / stop sync
// ══════════════════════════════════════════════════════════════════

// V3 Early Exit: if the bar right after entry closes against the trade, bail out
if v_early and IN_TRADE and strategy.opentrades > 0
    _fill_bar = strategy.opentrades.entry_bar_index(0)
    if bar_index == _fill_bar + 1
        _avg  = strategy.position_avg_price
        _fail = (strategy.position_size > 0 and close < _avg) or
                (strategy.position_size < 0 and close > _avg)
        if _fail
            strategy.close_all(comment="⚡ Early Exit")
            IN_TRADE := false

// CHoCH against open position → close immediately
if choch_dn and strategy.position_size > 0
    strategy.close_all(comment="CHoCH ↓ Flip")
    IN_TRADE := false

if choch_up and strategy.position_size < 0
    strategy.close_all(comment="CHoCH ↑ Flip")
    IN_TRADE := false

// ══════════════════════════════════════════════════════════════════
//  §16  V I S U A L S
// ══════════════════════════════════════════════════════════════════

// — Bias background —
if i_bg_v
    bgcolor(BIAS == "UPTREND"   ? color.new(color.teal, 93) :
            BIAS == "DOWNTREND" ? color.new(color.red,  93) : na,
            title="Bias Background")

// — Swing Labels (HH / HL / LH / LL) —
if i_sw_lbl and is_ph
    _hh_lbl = not na(HH_p) and ph_raw >= HH_p * (1.0 - i_tol)
    _lbl    = BIAS == "UPTREND"   ? (_hh_lbl ? "HH" : "LH") :
              BIAS == "DOWNTREND" ? "LH" : "H"
    _lc     = _hh_lbl ? color.teal : color.orange
    label.new(pivot_bar, ph_raw, _lbl, xloc=xloc.bar_index,
              color=color.new(_lc, 72), textcolor=_lc,
              style=label.style_label_down, size=size.tiny)

if i_sw_lbl and is_pl
    _ll_lbl = not na(LL_p) and pl_raw <= LL_p * (1.0 + i_tol)
    _lbl    = BIAS == "DOWNTREND" ? (_ll_lbl ? "LL" : "HL") :
              BIAS == "UPTREND"   ? "HL" : "L"
    _lc     = _ll_lbl ? color.red : color.green
    label.new(pivot_bar, pl_raw, _lbl, xloc=xloc.bar_index,
              color=color.new(_lc, 72), textcolor=_lc,
              style=label.style_label_up, size=size.tiny)

// — CHoCH Markers —
if i_choch_v and choch_dn
    label.new(bar_index, high, "CHoCH ↓",
              color=color.new(color.red, 5), textcolor=color.white,
              style=label.style_label_down, size=size.normal)

if i_choch_v and choch_up
    label.new(bar_index, low, "CHoCH ↑",
              color=color.new(color.teal, 5), textcolor=color.white,
              style=label.style_label_up, size=size.normal)

// — Signal Entry Zone Box (shows the live entry level while signal is armed) —
if i_zone_box
    if not na(SIG_DIR) and not IN_TRADE
        box.delete(SIG_BOX)
        _zone  = ATR * 0.12
        _is_l  = SIG_DIR == "LONG"
        _bhi   = _is_l ? SIG_ENTRY + _zone : SIG_ENTRY
        _blo   = _is_l ? SIG_ENTRY          : SIG_ENTRY - _zone
        _bc    = _is_l ? color.new(color.teal, 80) : color.new(color.red, 80)
        _brd   = _is_l ? color.new(color.teal, 35) : color.new(color.red, 35)
        SIG_BOX := box.new(bar_index, _bhi, bar_index + v_expiry, _blo,
                           bgcolor=_bc, border_color=_brd, border_width=1)
    else if IN_TRADE or na(SIG_DIR)
        box.delete(SIG_BOX)

// — Signal dotted level line —
var line SIG_LINE = na
if not na(SIG_DIR) and not IN_TRADE
    line.delete(SIG_LINE)
    _sc      = SIG_DIR == "LONG" ? color.new(color.teal, 20) : color.new(color.red, 20)
    SIG_LINE := line.new(bar_index, SIG_ENTRY, bar_index + 1, SIG_ENTRY,
                         extend=extend.right, color=_sc, width=2, style=line.style_dotted)
else
    line.delete(SIG_LINE)

// — Bar colouring while in trade —
if i_bar_col and IN_TRADE
    barcolor(TR_DIR == "LONG" ? color.new(color.teal, 45) : color.new(color.red, 45))

// ══════════════════════════════════════════════════════════════════
//  §17  D A S H B O A R D
//       (Strategy Tester panel shows full P&L stats automatically)
//       Dashboard shows live structural context + current signal
// ══════════════════════════════════════════════════════════════════
if i_dash and barstate.islast
    _pos = switch i_dash_pos
        "Top Right"   => position.top_right
        "Top Left"    => position.top_left
        "Bottom Left" => position.bottom_left
        =>               position.bottom_right

    DASH := table.new(_pos, 2, 11,
                      bgcolor      = color.new(color.gray, 88),
                      border_color = color.new(color.gray, 55),
                      border_width = 1,
                      frame_color  = color.new(color.silver, 25),
                      frame_width  = 2)

    // Live P&L from strategy engine
    _net    = strategy.netprofit
    _wr     = strategy.closedtrades > 0 ?
              strategy.wintrades / strategy.closedtrades * 100 : 0.0
    _dd     = strategy.max_drawdown_percent
    _pf     = strategy.grossprofit > 0 and math.abs(strategy.grossloss) > 0 ?
              strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    _eq     = strategy.equity
    _sig_s  = not na(SIG_DIR) ?
              SIG_DIR + " @ " + str.tostring(SIG_ENTRY, "#.##") : "—"
    _open_s = strategy.position_size != 0 ?
              (strategy.position_size > 0 ? "LONG" : "SHORT") +
              " @ " + str.tostring(strategy.position_avg_price, "#.##") : "—"

    // Header
    _hc = BIAS == "UPTREND"   ? color.new(color.teal, 20) :
          BIAS == "DOWNTREND" ? color.new(color.red,  20) : color.new(color.navy, 25)
    table.cell(DASH, 0, 0, "CHoCH BIAS PRO · " + i_variant,
               text_color=color.white, text_size=size.small,
               bgcolor=_hc, text_halign=text.align_left)
    table.cell(DASH, 1, 0, BIAS,
               text_color = BIAS == "UPTREND"   ? color.teal :
                            BIAS == "DOWNTREND" ? color.red  : color.gray,
               text_size=size.small, bgcolor=_hc, text_halign=text.align_right)

    // Rows
    dash_row(DASH,  1, " Trades",    str.tostring(strategy.closedtrades),              color.white)
    dash_row(DASH,  2, " Win Rate",  str.tostring(_wr,  "#.1") + "%",                  _wr>=65?color.lime:_wr>=50?color.yellow:color.red)
    dash_row(DASH,  3, " Net P&L",   (_net>=0?"$+":"$") + str.tostring(_net,"#.##"),   _net>=0?color.lime:color.red)
    dash_row(DASH,  4, " Equity",    "$" + str.tostring(_eq, "#.##"),                  color.white)
    dash_row(DASH,  5, " Profit F.",  str.tostring(_pf,  "#.2"),                        _pf>=1.5?color.lime:_pf>=1?color.yellow:color.red)
    dash_row(DASH,  6, " Max DD",    str.tostring(_dd,  "#.1") + "%",                  _dd<=10?color.lime:_dd<=20?color.yellow:color.red)
    dash_row(DASH,  7, " ADX",       str.tostring(ADX,  "#.1"),                        ADX>v_adx_thr?color.lime:color.yellow)
    dash_row(DASH,  8, " RSI",       str.tostring(RSI,  "#.1"),                        RSI>70?color.orange:RSI<30?color.aqua:color.white)
    dash_row(DASH,  9, " Signal",    _sig_s,                                            color.yellow)
    dash_row(DASH, 10, " Open",      _open_s,                                           strategy.position_size!=0?color.orange:color.new(color.gray,20))

// ══════════════════════════════════════════════════════════════════
//  §18  P L O T S  (invisible — used by alert {{plot}} tokens)
// ══════════════════════════════════════════════════════════════════
plot(strategy.position_size != 0 ? strategy.position_avg_price : na,
     "Entry Price", color=na, display=display.none)
plot(IN_TRADE ? TR_STOP : na, "Active SL", color=na, display=display.none)
plot(IN_TRADE ? TR_TP   : na, "Active TP", color=na, display=display.none)

// ══════════════════════════════════════════════════════════════════
//  §19  A L E R T S
// ══════════════════════════════════════════════════════════════════
alertcondition(entry_long,
               title   = "LONG Entry",
               message = "CHoCH Pro ▲ LONG @ {{close}}  SL={{plot_1}}  TP={{plot_2}}")

alertcondition(entry_short,
               title   = "SHORT Entry",
               message = "CHoCH Pro ▼ SHORT @ {{close}}  SL={{plot_1}}  TP={{plot_2}}")

alertcondition(choch_up,
               title   = "CHoCH Bull Flip",
               message = "CHoCH: Bearish → Bullish flip @ {{close}}")

alertcondition(choch_dn,
               title   = "CHoCH Bear Flip",
               message = "CHoCH: Bullish → Bearish flip @ {{close}}")

alertcondition(not na(SIG_DIR) and not IN_TRADE,
               title   = "Signal Armed",
               message = "CHoCH: {{interval}} signal armed — waiting for entry @ {{close}}")

alertcondition(IN_TRADE and strategy.openprofit < 0,
               title   = "Trade Underwater",
               message = "CHoCH: Open trade in drawdown @ {{close}}")
