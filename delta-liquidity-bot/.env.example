# ---- Delta Exchange credentials (create at: Account -> API Keys; enable Trading) ----
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange
# Testnet instead:  https://cdn-ind.testnet.deltaex.org

# ---- SAFETY: stays in dry-run until you flip this to true ----
LIVE=false

# ---- market / timeframes ----
SYMBOL=BTCUSD
STRUCTURE_TF=4h
SIGNAL_TF=1h
SETTLE_ASSET=USDT

# ---- risk / sizing ----
RISK_PCT=2.0
TP_R_MULTIPLE=2.0
MAX_LEVERAGE=10
CONTRACT_VALUE=0        # 0 = auto-read from product metadata

# ---- which signals to trade ----
ENABLE_LONG_SWEEP=true
ENABLE_SHORT_SWEEP=true
ENABLE_FLIP=true

# ---- fakeout guards (tune carefully) ----
SWING_LEFT=2
SWING_RIGHT=2
RANGE_LOOKBACK=40
VOL_LOOKBACK=20
VOL_FACTOR=1.3          # sweep candle must beat avg volume by this factor
EDGE_BAND=0.25          # level must sit within 25% of a range edge
RECLAIM_BUFFER=0.0005   # close must reclaim the level by >= 0.05%
FLIP_BUFFER=0.0010      # flip close must clear the extreme by >= 0.10%

# ---- loop ----
POLL_SECONDS=60
