# Delta Exchange credentials (create at: Account -> API Keys; enable Trading).
# NOTE: keep every value on its own line with NO trailing "# comment" -- when
# this file is used as a systemd EnvironmentFile, inline comments become part
# of the value and break numeric parsing.
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange
# Testnet base instead: https://cdn-ind.testnet.deltaex.org

# SAFETY: stays in dry-run until this is true
LIVE=false

# market / timeframes
SYMBOL=BTCUSD
STRUCTURE_TF=4h
SIGNAL_TF=1h
SETTLE_ASSET=USDT

# risk / sizing
RISK_PCT=2.0
TP_R_MULTIPLE=2.0
MAX_LEVERAGE=10
# 0 = auto-read contract value from product metadata
CONTRACT_VALUE=0

# which signals to trade
ENABLE_LONG_SWEEP=true
ENABLE_SHORT_SWEEP=true
ENABLE_FLIP=true

# fakeout guards
SWING_LEFT=2
SWING_RIGHT=2
RANGE_LOOKBACK=40
VOL_LOOKBACK=20
# sweep candle must beat avg volume by this factor
VOL_FACTOR=1.3
# level must sit within this fraction of a range edge
EDGE_BAND=0.25
# close must reclaim the level by >= this fraction (0.0005 = 0.05%)
RECLAIM_BUFFER=0.0005
# flip close must clear the extreme by >= this fraction
FLIP_BUFFER=0.0010

# loop
POLL_SECONDS=60
