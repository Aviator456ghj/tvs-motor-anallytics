# Copy to .env and fill in real values. NEVER commit the real .env file.
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

DELTA_PRODUCT_SYMBOL=BTCUSD
RISK_PCT=0.01

# Safety gates - both must be set for a real order to ever be placed.
# Leave DRY_RUN=true (default) until selftest() and a few dry-run passes
# have been verified against live data.
DRY_RUN=true
LIVE_TRADING_CONFIRM=

BOT_STATE_FILE=
BOT_STATUS_FILE=

# Dashboard (dashboard/app.py). Leave both blank to keep it localhost-only
# (it refuses to bind to 0.0.0.0 without credentials). Set both, then
# reach it at http://<host>:DASHBOARD_PORT with this username/password.
DASHBOARD_PORT=8080
DASHBOARD_USER=
DASHBOARD_PASSWORD=
