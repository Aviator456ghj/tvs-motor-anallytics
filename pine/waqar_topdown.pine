//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Waqar Asim "Top Down Analysis" — pullback re-entry (Experimental)
//
// Mechanical translation of the video's 5-step framework:
//   1) External range A->B of a confirmed CHoCH/BOS (swing width kExt).
//   2) 2-leg pullback signature after B, at a FINER swing width kLeg -- a
//      swing that FAILS to exceed B (lower high in an uptrend / higher low
//      in a downtrend), then a swing that breaks the prior same-direction
//      swing (lower low / higher high). Confirms the pullback has begun.
//   3) Objective = the 50% retracement of the external range (A,B).
//   4) Entry: once price touches that 50% level, a counter candle followed
//      by an engulfing confirmation candle (WITH the original direction)
//      triggers entry -- the video's own fallback ("a simple 3-candle
//      engulfing"), since true cross-timeframe confirmation isn't
//      reproducible as a single compiling Pine script (see note below).
//   5) Exit: ride until the external trend itself ends (the next opposite
//      CHoCH) -- the video's "leaving a runner for the larger trend".
//
// ⚠️ SINGLE-TIMEFRAME SIMPLIFICATION: the original backtest used REAL 1h
// (external range, k=5) + 15m (pullback leg, k=3) data -- roughly a 6-7x
// scale separation between the two. An earlier version of this script
// tried to reproduce that exactly via request.security() pulling a
// stateful 1h function into a 15m chart -- that does NOT compile: Pine
// disallows request.security() on a user function that contains var/varip
// state. This version collapses both steps onto ONE chart using two swing
// widths (kExt = external/coarse, kLeg = pullback-leg/fine).
//
// RUN THIS ON THE 15-MINUTE CHART, with kExt=20 and kLeg=3 (the defaults
// below). kExt=20 on 15m bars spans the same ~5 hours each side as the
// original 1h k=5 external swing; kLeg=3 matches the original 15m k=3
// exactly (it was already native to that timeframe). An earlier version of
// this note wrongly suggested running on the 1h chart with kExt=5/kLeg=2 --
// that collapses the two swing widths to nearly the same scale (a ~2.5x
// ratio instead of ~6.7x), so the 2-leg pullback signature almost never
// resolves and the strategy can end up placing zero trades. If you still
// see very few trades, try widening the ratio further (e.g. kExt=24-30).
// Behavior will be directionally similar to, but not numerically identical
// to, the reported backtest (PF 1.35/+10% BTC, PF 2.64/+96% ETH in "ride"
// mode, on real separate 1h+15m data) -- compare against the chart before
// trusting it, and paper trade first.
//
// ⚠️ HONESTY NOTE ON THE EDGE ITSELF: the video's own literal "1:3 partial
// take-profit" exit was weak/negative on ETH in backtesting -- only the
// ride-to-next-CHoCH exit passed on both symbols, so that's the only exit
// mode here. ETH's backtested return was also concentration-heavy (a
// handful of 20-40R trend-continuation trades drove most of the total on
// a ~28% win rate) -- lumpy, requires discipline to hold through losers.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Waqar Top-Down Pullback Re-Entry (Experimental)",
     overlay = true,
     initial_capital = 1000,
     currency = currency.USD,
     commission_type = strategy.commission.percent,
     commission_value = 0.035,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// ───────────────────────────── inputs ────────────────────────────────────────
kExt      = input.int(20, "External range swing width (kExt) — run on 15m chart", minval = 5, maxval = 60)
kLeg      = input.int(3, "Pullback-leg swing width (kLeg, finer)", minval = 1, maxval = 10)
bufAtr    = input.float(0.3, "Stop buffer beyond touch (x ATR)", step = 0.1)
riskPct   = input.float(0.5, "Risk per trade (% equity)", step = 0.1)
maxLev    = input.float(3.0, "Max leverage", step = 0.5)

atr14 = ta.atr(14)

// ───────────────────── external-range CHoCH (A, B, dir) ──────────────────────
var float h1 = na
var float h2 = na
var int   h1_bar = na
var int   h2_bar = na
var float l1 = na
var float l2 = na
var int   l1_bar = na
var int   l2_bar = na
var int   pendingUpBreakBar = na
var int   pendingDnBreakBar = na
var float pendingA_up = na
var float pendingA_dn = na
var int   dir = 0
var float extA = na
var float extB = na
var int   dirFlipCount = 0
var int   sigDoneCount = 0
var int   entryCount   = 0

ph = ta.pivothigh(high, kExt, kExt)
pl = ta.pivotlow(low, kExt, kExt)

if not na(ph)
    atBarH = bar_index - kExt
    if not na(pendingUpBreakBar) and atBarH > pendingUpBreakBar
        dir := 1
        extA := pendingA_up
        extB := ph
        pendingUpBreakBar := na
        dirFlipCount += 1
    h2 := h1
    h2_bar := h1_bar
    h1 := ph
    h1_bar := atBarH

if not na(pl)
    atBarL = bar_index - kExt
    if not na(pendingDnBreakBar) and atBarL > pendingDnBreakBar
        dir := -1
        extA := pendingA_dn
        extB := pl
        pendingDnBreakBar := na
        dirFlipCount += 1
    l2 := l1
    l2_bar := l1_bar
    l1 := pl
    l1_bar := atBarL

if not na(h1) and not na(h2) and na(pendingUpBreakBar) and h1 < h2 and close > h1 and bar_index > h1_bar
    pendingUpBreakBar := bar_index
    pendingA_up := l1
    if dir == -1
        dir := 0

if not na(l1) and not na(l2) and na(pendingDnBreakBar) and l1 > l2 and close < l1 and bar_index > l1_bar
    pendingDnBreakBar := bar_index
    pendingA_dn := h1
    if dir == 1
        dir := 0

// ───────────────────── pullback-leg swings (finer width) ────────────────────
phL = ta.pivothigh(high, kLeg, kLeg)
plL = ta.pivotlow(low, kLeg, kLeg)

var int   lastDir        = 0
var bool  failedSeen     = false
var float priorSameKind  = na
var bool  sigDone        = false
var bool  waitingEntry   = false
var bool  pendingCounter = false
var float counterOpen    = na

if dir != lastDir
    failedSeen := false
    priorSameKind := na
    sigDone := false
    waitingEntry := false
    pendingCounter := false
    lastDir := dir

if dir == 1 and not na(extB)
    if not na(phL)
        failedSeen := phL < extB
    if not na(plL)
        if failedSeen and not sigDone
            if not na(priorSameKind) and plL < priorSameKind
                sigDone := true
                sigDoneCount += 1
            priorSameKind := plL
        else if not failedSeen
            priorSameKind := plL
else if dir == -1 and not na(extB)
    if not na(plL)
        failedSeen := plL > extB
    if not na(phL)
        if failedSeen and not sigDone
            if not na(priorSameKind) and phL > priorSameKind
                sigDone := true
                sigDoneCount += 1
            priorSameKind := phL
        else if not failedSeen
            priorSameKind := phL

if sigDone and not waitingEntry
    waitingEntry := true

// ───────────────────── objective touch + engulf entry confirmation ──────────
float mid = na
if not na(extA) and not na(extB)
    mid := (extA + extB) / 2.0

sigLong  = false
sigShort = false

if waitingEntry and not na(mid) and not pendingCounter
    touched = dir == 1 ? (low <= mid) : (high >= mid)
    counter = dir == 1 ? (close < open) : (close > open)
    if touched and counter
        pendingCounter := true
        counterOpen := open

if pendingCounter
    confDir  = dir == 1 ? (close > open) : (close < open)
    engulfOk = dir == 1 ? (close > counterOpen) : (close < counterOpen)
    if confDir and engulfOk
        if dir == 1
            sigLong := true
        else
            sigShort := true
        entryCount += 1
        pendingCounter := false
        waitingEntry := false
        sigDone := false
    else if not confDir
        pendingCounter := false

// ───────────────────────────── exits (ride the external trend) ───────────────
if strategy.position_size > 0 and dir != 1
    strategy.close("Long", comment = "trend ended")
if strategy.position_size < 0 and dir != -1
    strategy.close("Short", comment = "trend ended")

// ───────────────────────────── entries ────────────────────────────────────────
if sigLong and strategy.position_size == 0 and not na(extA)
    stopLvl  = math.min(low, extA) - bufAtr * atr14
    stopDist = close - stopLvl
    if stopDist > 0
        qtyRisk = strategy.equity * riskPct / 100 / stopDist
        qtyCap  = strategy.equity * maxLev / close
        strategy.entry("Long", strategy.long, qty = math.min(qtyRisk, qtyCap))
        strategy.exit("Long Stop", "Long", stop = stopLvl)

if sigShort and strategy.position_size == 0 and not na(extA)
    stopLvl  = math.max(high, extA) + bufAtr * atr14
    stopDist = stopLvl - close
    if stopDist > 0
        qtyRisk = strategy.equity * riskPct / 100 / stopDist
        qtyCap  = strategy.equity * maxLev / close
        strategy.entry("Short", strategy.short, qty = math.min(qtyRisk, qtyCap))
        strategy.exit("Short Stop", "Short", stop = stopLvl)

// ───────────────────────────── visuals ───────────────────────────────────────
// diagnostic background: pale green/red = dir is active; a brighter stripe
// = the 2-leg pullback signature has fired and it's watching for the 50%
// touch. If you NEVER see the brighter stripe, the signature step is what's
// blocking entries -- try widening kExt relative to kLeg further.
bgcolor(dir == 1 ? color.new(#1baf7a, 94) : dir == -1 ? color.new(#e34948, 94) : na, title = "dir active")
bgcolor(waitingEntry ? (dir == 1 ? color.new(#1baf7a, 75) : color.new(#e34948, 75)) : na, title = "signature confirmed, watching for touch")

plot(extA, "External origin (A)", color = color.new(#898781, 30), style = plot.style_stepline)
plot(extB, "External peak (B)",   color = color.new(#898781, 30), style = plot.style_stepline)
plot(mid, "50% objective", color = color.new(#eda100, 0), style = plot.style_stepline, linewidth = 2)

plotshape(sigLong, "Pullback long entry", shape.triangleup, location.belowbar,
     color.new(#1baf7a, 0), size = size.small)
plotshape(sigShort, "Pullback short entry", shape.triangledown, location.abovebar,
     color.new(#e34948, 0), size = size.small)
plotshape(waitingEntry and not pendingCounter, "Waiting for objective touch", shape.circle,
     location.belowbar, color.new(#2a78d6, 40), size = size.tiny)

var table info = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 65), border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "Bias", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, dir == 1 ? "BULLISH" : dir == -1 ? "BEARISH" : "NEUTRAL",
         text_color = dir == 1 ? color.new(#1baf7a, 0) : dir == -1 ? color.new(#e34948, 0) : color.gray, text_size = size.small)
    table.cell(info, 0, 1, "Signature", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 1, sigDone or waitingEntry ? "confirmed, watching" : "waiting", text_color = color.yellow, text_size = size.tiny)
    table.cell(info, 0, 2, "Position", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 2, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color = strategy.position_size > 0 ? color.new(#1baf7a, 0) : strategy.position_size < 0 ? color.new(#e34948, 0) : color.gray, text_size = size.tiny)
    table.cell(info, 0, 3, "Bias flips (total)", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 3, str.tostring(dirFlipCount), text_color = color.aqua, text_size = size.tiny)
    table.cell(info, 0, 4, "Signatures (total)", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 4, str.tostring(sigDoneCount), text_color = color.aqua, text_size = size.tiny)
    table.cell(info, 0, 5, "Entries (total)", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 5, str.tostring(entryCount), text_color = color.aqua, text_size = size.tiny)
