//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Waqar Asim "Top Down Analysis" — pullback re-entry (Experimental)
//
// Mechanical translation of the video's 5-step framework:
//   1) 1h  : external range A->B of a confirmed CHoCH/BOS (same detection
//            style as this repo's other CHoCH scripts).
//   2) 15m : 2-leg pullback signature after B -- a 15m swing that FAILS to
//            exceed B (lower high in an uptrend / higher low in a
//            downtrend), then a 15m swing that breaks the prior 15m swing
//            of the ORIGINAL trend's kind (lower low / higher high).
//   3) Objective = the 50% retracement of the 1h external range (A,B).
//   4) Entry: once price touches that 50% level, a counter candle followed
//      by an engulfing confirmation candle (WITH the original 1h
//      direction) triggers entry -- the video's own fallback ("a simple
//      3-candle engulfing") since true 1-minute confirmation isn't
//      reproducible mechanically here.
//   5) Exit: ride until the 1h trend itself ends (the next opposite 1h
//      CHoCH) -- the video's "leaving a runner for the larger external
//      trend continuation".
//
// ⚠️ HONESTY NOTE: backtested on 540 days of 1h/15m BTCUSD/ETHUSD. The
// RIDE exit (this script's only exit mode) is profitable on BOTH symbols
// (BTC PF 1.35, +10%; ETH PF 2.64, +96%) -- but the video's own literal
// "1:3 partial take-profit" version is markedly weaker and NEGATIVE on
// ETH, so this script deliberately does NOT offer a fixed-R exit as the
// default. ETH's return is also concentration-heavy: a handful of huge
// trend-continuation trades (several 20-40R) drive most of the total —
// low win rate (~28%), lumpy, requires discipline to hold. The 1h
// A/B (external range) approximation uses the LAST confirmed swing
// low/high before the break as "A", a simpler proxy than a full
// min/max-since-prior-swing search — a disclosed mechanical
// simplification, same spirit as other ports in this repo. Paper trade
// before any size.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Waqar Top-Down Pullback Re-Entry (Experimental)",
     overlay = true,
     initial_capital = 1000,
     currency = currency.USD,
     commission_type = strategy.commission.percent,
     commission_value = 0.035,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// ───────────────────────────── inputs ────────────────────────────────────────
htfTF     = input.timeframe("60", "External range timeframe (1h)")
kHtf      = input.int(5, "1h swing width (k)", minval = 3, maxval = 12)
kLtf      = input.int(3, "15m pullback-leg swing width (k)", minval = 2, maxval = 8)
bufAtr    = input.float(0.3, "Stop buffer beyond touch (x ATR)", step = 0.1)
riskPct   = input.float(0.5, "Risk per trade (% equity)", step = 0.1)
maxLev    = input.float(3.0, "Max leverage", step = 0.5)

// NOTE: this script must run on a 15-MINUTE chart (matches what was
// actually backtested: 15m used for both the pullback signature AND the
// entry confirmation). The 1h external range is pulled in via
// request.security below.
atr14 = ta.atr(14)

// ───────────────────── 1h external-range CHoCH (imported via security) ──────
htf_state() =>
    var float h1 = na, h2 = na
    var int   h1_bar = na, h2_bar = na
    var float l1 = na, l2 = na
    var int   l1_bar = na, l2_bar = na
    var int   pendingUpBreakBar = na
    var int   pendingDnBreakBar = na
    var float pendingA_up = na, pendingA_dn = na
    var int   dir = 0
    var float A = na
    var float B = na

    ph = ta.pivothigh(kHtf, kHtf)
    pl = ta.pivotlow(kHtf, kHtf)

    if not na(ph)
        atBarH = bar_index - kHtf
        if not na(pendingUpBreakBar) and atBarH > pendingUpBreakBar
            dir := 1
            A := pendingA_up
            B := ph
            pendingUpBreakBar := na
        h2 := h1
        h2_bar := h1_bar
        h1 := ph
        h1_bar := atBarH

    if not na(pl)
        atBarL = bar_index - kHtf
        if not na(pendingDnBreakBar) and atBarL > pendingDnBreakBar
            dir := -1
            A := pendingA_dn
            B := pl
            pendingDnBreakBar := na
        l2 := l1
        l2_bar := l1_bar
        l1 := pl
        l1_bar := atBarL

    if not na(h1) and not na(h2) and na(pendingUpBreakBar) and h1 < h2 and close > h1 and bar_index > h1_bar
        pendingUpBreakBar := bar_index
        pendingA_up := l1
        if dir == -1
            dir := 0
    if not na(l1) and not na(l2) and na(pendingDnBreakBar) and l1 > l2 and close < l1 and bar_index > l1_bar
        pendingDnBreakBar := bar_index
        pendingA_dn := h1
        if dir == 1
            dir := 0

    [dir, A, B]

[dir1h, A1h, B1h] = request.security(syminfo.tickerid, htfTF, htf_state(), lookahead = barmerge.lookahead_off)

// ───────────────────── 15m: 2-leg pullback signature (native) ───────────────
ph15 = ta.pivothigh(kLtf, kLtf)
pl15 = ta.pivotlow(kLtf, kLtf)

var int   lastDir       = 0
var bool  failedSeen    = false
var float priorSameKind = na
var bool  sigDone       = false
var bool  waitingEntry  = false
var bool  pendingCounter = false
var float counterOpen   = na

if dir1h != lastDir
    failedSeen := false
    priorSameKind := na
    sigDone := false
    waitingEntry := false
    pendingCounter := false
    lastDir := dir1h

if dir1h == 1 and not na(B1h)
    if not na(ph15)
        failedSeen := ph15 < B1h
    if not na(pl15)
        if failedSeen and not sigDone
            if not na(priorSameKind) and pl15 < priorSameKind
                sigDone := true
            priorSameKind := pl15
        else if not failedSeen
            priorSameKind := pl15
else if dir1h == -1 and not na(B1h)
    if not na(pl15)
        failedSeen := pl15 > B1h
    if not na(ph15)
        if failedSeen and not sigDone
            if not na(priorSameKind) and ph15 > priorSameKind
                sigDone := true
            priorSameKind := ph15
        else if not failedSeen
            priorSameKind := ph15

if sigDone and not waitingEntry
    waitingEntry := true

// ───────────────────── objective touch + engulf entry confirmation ──────────
mid1h = (not na(A1h) and not na(B1h)) ? (A1h + B1h) / 2.0 : na

sigLong  = false
sigShort = false

if waitingEntry and not na(mid1h) and not pendingCounter
    touched = dir1h == 1 ? (low <= mid1h) : (high >= mid1h)
    counter = dir1h == 1 ? (close < open) : (close > open)
    if touched and counter
        pendingCounter := true
        counterOpen := open

if pendingCounter
    confDir  = dir1h == 1 ? (close > open) : (close < open)
    engulfOk = dir1h == 1 ? (close > counterOpen) : (close < counterOpen)
    if confDir and engulfOk
        if dir1h == 1
            sigLong := true
        else
            sigShort := true
        pendingCounter := false
        waitingEntry := false
        sigDone := false
    else if not confDir
        pendingCounter := false

// ───────────────────────────── exits (ride the 1h trend) ─────────────────────
if strategy.position_size > 0 and dir1h != 1
    strategy.close("Long", comment = "1h trend ended")
if strategy.position_size < 0 and dir1h != -1
    strategy.close("Short", comment = "1h trend ended")

// ───────────────────────────── entries ────────────────────────────────────────
if sigLong and strategy.position_size == 0 and not na(A1h)
    stopLvl  = math.min(low, A1h) - bufAtr * atr14
    stopDist = close - stopLvl
    if stopDist > 0
        qtyRisk = strategy.equity * riskPct / 100 / stopDist
        qtyCap  = strategy.equity * maxLev / close
        strategy.entry("Long", strategy.long, qty = math.min(qtyRisk, qtyCap))
        strategy.exit("Long Stop", "Long", stop = stopLvl)

if sigShort and strategy.position_size == 0 and not na(A1h)
    stopLvl  = math.max(high, A1h) + bufAtr * atr14
    stopDist = stopLvl - close
    if stopDist > 0
        qtyRisk = strategy.equity * riskPct / 100 / stopDist
        qtyCap  = strategy.equity * maxLev / close
        strategy.entry("Short", strategy.short, qty = math.min(qtyRisk, qtyCap))
        strategy.exit("Short Stop", "Short", stop = stopLvl)

// ───────────────────────────── visuals ───────────────────────────────────────
plot(A1h, "External origin (A, 1h)", color = color.new(#898781, 30), style = plot.style_stepline)
plot(B1h, "External peak (B, 1h)",   color = color.new(#898781, 30), style = plot.style_stepline)
plot(mid1h, "50% objective", color = color.new(#eda100, 0), style = plot.style_stepline, linewidth = 2)

plotshape(sigLong, "Pullback long entry", shape.triangleup, location.belowbar,
     color.new(#1baf7a, 0), size = size.small)
plotshape(sigShort, "Pullback short entry", shape.triangledown, location.abovebar,
     color.new(#e34948, 0), size = size.small)
plotshape(waitingEntry and not pendingCounter, "Waiting for objective touch", shape.circle,
     location.belowbar, color.new(#2a78d6, 40), size = size.tiny)

var table info = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 65), border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "1h bias", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, dir1h == 1 ? "BULLISH" : dir1h == -1 ? "BEARISH" : "NEUTRAL",
         text_color = dir1h == 1 ? color.new(#1baf7a,0) : dir1h == -1 ? color.new(#e34948,0) : color.gray, text_size = size.small)
    table.cell(info, 0, 1, "Signature", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 1, sigDone or waitingEntry ? "confirmed, watching" : "waiting", text_color = color.yellow, text_size = size.tiny)
    table.cell(info, 0, 2, "Position", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 2, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color = strategy.position_size > 0 ? color.new(#1baf7a,0) : strategy.position_size < 0 ? color.new(#e34948,0) : color.gray, text_size = size.tiny)
