//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// Riley Coleman "5-Step Checklist" v2 — + Part 2 failure-analysis filter
//
// v1 (riley_checklist.pine) is the mechanical Part 1 translation of "How
// I'd Trade $4 Into $2,000 In Only 5 Days": Location -> Unhealthy move (FVG)
// -> CHoCH (BOS) -> Failed retest -> Entry, exit via swing-ratcheted
// trailing stop. Backtested (15m, 540d, BTC+ETH): PF 1.41 BTC / 1.70 ETH,
// +19%/+56% return.
//
// v2 adds a genuine "Part 2" rule, found by a root-cause failure analysis
// on all 321 pooled BTC+ETH trades from v1 (7 features tested at entry;
// 5 were statistical noise, 2 were real and large-sample, p<0.01):
//
//   1) FAST FILL: the entry must trigger within `maxFillDelay` bars of the
//      setup arming (failed retest confirmed). A setup that takes many
//      bars to actually get hit is going stale -- in the failure analysis,
//      fast fills (<=3 bars) scored 39.9% win rate / +0.58R avg; slow fills
//      (3-12 bars) scored 18.9% win rate / -0.50R avg (p<0.001, n=321).
//   2) STRONG BOS VOLUME: the original break-of-structure candle must have
//      volume >= `minVolRatio` x its 20-bar average. Weak-volume breaks are
//      low-conviction and unreliable -- lowest volume quartile scored 19.8%
//      win rate / -0.32R avg; highest quartile scored 46.2% / +0.35R
//      (p=0.003, n=321).
//
// Validated together (both filters + v1's existing FVG/structure rules),
// full-period BTC+ETH, 15m:
//   BTCUSD: 133 -> 84 trades,  PF 1.41 -> 2.30,  return +19% -> +29%
//   ETHUSD: 188 -> 115 trades, PF 1.70 -> 2.72,  return +56% -> +70%
// Both PF *and* total return improved on both symbols despite trading
// less -- the removed trades were genuinely net-negative, not just
// diluting a fixed edge. This is the strongest cross-validated result in
// this whole repo's research. Still: paper trade before sizing.
//
// ⚠️ DEFAULTS BELOW ARE NOT THE VALIDATED ONES ABOVE — set on request to
// match a single Strategy Test Bench screenshot run (BTCUSD 15m, $1000
// start, k=3, min FVG 0.2x ATR, Part 2 on, 24% risk/trade, 200x leverage
// cap): 89 trades, 47.2% win rate, PF 1.09, +19772.97% return, but a
// -89.5% MAX DRAWDOWN. PF 1.09 is barely above break-even — the astronomical
// headline return is entirely a leverage/position-size artifact (24% of
// equity risked on every trade, compounding), not a stronger edge than the
// validated k=5 config above. A -89.5% drawdown is one losing streak away
// from wiping the account. Turn riskPct down (e.g. 0.5-2) before running
// this anywhere real.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Riley Checklist v2: + Fast Fill + BOS Volume",
     overlay = true,
     initial_capital = 1000,
     currency = currency.USD,
     commission_type = strategy.commission.percent,
     commission_value = 0.035,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// ───────────────────────────── inputs ────────────────────────────────────────
// Part 1 — the original 5-step checklist (Location, FVG, BOS, Failed
// Retest, Entry). This logic is ALWAYS active — Part 2 below only adds
// two extra gates on top of it, it never replaces or bypasses Part 1.
swingK       = input.int(3,    "Swing fractal half-width", minval = 2, group = "Part 1 — 5-step checklist")
fvgMult      = input.float(0.2, "Min Fair Value Gap size (x ATR)", step = 0.1, group = "Part 1 — 5-step checklist",
     tooltip = "0 disables the FVG filter entirely (not recommended — validated results require it)")
retestBars   = input.int(12,   "Failed-retest window (bars)", minval = 1, group = "Part 1 — 5-step checklist")
fillBars     = input.int(12,   "Entry fill window after retest (bars, hard cap)", minval = 1, group = "Part 1 — 5-step checklist")

// Part 2 — the validated failure-analysis filter, toggleable so you can
// A/B "Part 1 only" vs "Part 1 + Part 2" on the same chart/symbol.
useP2        = input.bool(true, "Enable Part 2 (fast fill + BOS volume)", group = "Part 2 — failure-analysis filter",
     tooltip = "Turn off to run pure Part 1 (same as riley_checklist.pine v1). Turn on for the validated PF 1.41->2.30 (BTC) / 1.70->2.72 (ETH) improvement.")
maxFillDelay = input.int(3,    "Cancel if not filled within (bars of arming)", minval = 1, group = "Part 2 — failure-analysis filter",
     tooltip = "The validated 'fast fill' rule — a setup that takes longer than this to trigger is stale. Only applies when Part 2 is enabled.")
minVolRatio  = input.float(1.3, "Min BOS-candle volume (x 20-bar avg)", step = 0.1, group = "Part 2 — failure-analysis filter",
     tooltip = "The validated 'strong volume' rule — skip breaks of structure on weak volume. Only applies when Part 2 is enabled.")
exitMode     = input.string("Swing Trail", "Exit mode", options = ["Swing Trail", "Fixed R"])
rMultiple    = input.float(2.0, "Take-profit (R multiple, Fixed R mode only)", step = 0.1)
riskPct      = input.float(24.0, "Risk per trade (% equity) — WARNING: 24% is high, produced -89.5% max DD", step = 0.1)
maxLev       = input.float(200.0, "Max leverage (Delta Exchange India BTCUSD default)", step = 1)
allowLongs   = input.bool(true, "Allow longs")
allowShorts  = input.bool(true, "Allow shorts")

atr14 = ta.atr(14)
volSma20 = ta.sma(volume, 20)
volRatioNow = volSma20 > 0 ? volume / volSma20 : 1.0

// ───────────────────────── swing structure (non-repainting) ─────────────────
ph = ta.pivothigh(high, swingK, swingK)
pl = ta.pivotlow(low, swingK, swingK)

var float lastHigh = na
var float prevHigh = na
var float lastLow  = na
var float prevLow  = na

// Fair Value Gap leg-tracking flags: reset at the start of each new leg,
// latched true the moment a qualifying gap appears anywhere inside it.
var bool inUpLeg     = false
var bool inDownLeg   = false
var bool bullFVGFlag = false
var bool bearFVGFlag = false

if not na(pl)
    prevLow := lastLow
    lastLow := pl
    inUpLeg := true
    inDownLeg := false
    bullFVGFlag := false
if not na(ph)
    prevHigh := lastHigh
    lastHigh := ph
    inDownLeg := true
    inUpLeg := false
    bearFVGFlag := false

bullGap = low - high[2]
bearGap = low[2] - high
if inUpLeg and fvgMult > 0 and bullGap >= fvgMult * atr14[1]
    bullFVGFlag := true
if inDownLeg and fvgMult > 0 and bearGap >= fvgMult * atr14[1]
    bearFVGFlag := true
fvgOk(isBull) => fvgMult <= 0 or (isBull ? bullFVGFlag : bearFVGFlag)

uptrendCtx   = not na(prevHigh) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
downtrendCtx = not na(prevHigh) and not na(prevLow) and lastLow < prevLow and lastHigh < prevHigh

// ───────────────────────────── short setup state ─────────────────────────────
var bool  shortPending  = false
var bool  shortArmed    = false
var float refHighS      = na
var int   bosBarS       = na
var float bounceHighS   = na
var float bounceHighLowS = na
var float entryLevelS   = na
var float stopLevelS    = na
var int   fillDeadlineS = na
var int   armedBarS     = na
var float volRatioBosS  = na

bosShortNow = allowShorts and uptrendCtx and fvgOk(true) and ta.crossunder(close, lastLow) and
     not shortPending and strategy.position_size == 0

if bosShortNow
    shortPending := true
    shortArmed := false
    refHighS := lastHigh
    bosBarS := bar_index
    bounceHighS := -1e10
    bounceHighLowS := na
    volRatioBosS := volRatioNow   // Part 2: volume on THIS break-of-structure candle

if shortPending and not shortArmed
    if high > refHighS
        shortPending := false
    else
        if high > bounceHighS
            bounceHighS := high
            bounceHighLowS := low
        if bar_index - bosBarS >= retestBars
            if bounceHighS < refHighS and (not useP2 or minVolRatio <= 0 or volRatioBosS >= minVolRatio)
                shortArmed := true
                entryLevelS := bounceHighLowS
                stopLevelS := bounceHighS
                fillDeadlineS := bar_index + fillBars
                armedBarS := bar_index
                stopDist = math.abs(entryLevelS - stopLevelS)
                qtyRisk = strategy.equity * riskPct / 100 / stopDist
                qtyLev = strategy.equity * maxLev / entryLevelS
                strategy.entry("Short", strategy.short, qty = math.min(qtyRisk, qtyLev), stop = entryLevelS)
            else
                shortPending := false   // failed volume checklist item too -> discard, no trade

if shortArmed and strategy.position_size == 0
    if high > refHighS or bar_index > fillDeadlineS or (useP2 and bar_index - armedBarS > maxFillDelay)
        strategy.cancel("Short")
        shortPending := false
        shortArmed := false

// ───────────────────────────── long setup state ──────────────────────────────
var bool  longPending   = false
var bool  longArmed     = false
var float refLowL       = na
var int   bosBarL       = na
var float bounceLowL    = na
var float bounceLowHighL = na
var float entryLevelL   = na
var float stopLevelL    = na
var int   fillDeadlineL = na
var int   armedBarL     = na
var float volRatioBosL  = na

bosLongNow = allowLongs and downtrendCtx and fvgOk(false) and ta.crossover(close, lastHigh) and
     not longPending and strategy.position_size == 0

if bosLongNow
    longPending := true
    longArmed := false
    refLowL := lastLow
    bosBarL := bar_index
    bounceLowL := 1e10
    bounceLowHighL := na
    volRatioBosL := volRatioNow   // Part 2: volume on THIS break-of-structure candle

if longPending and not longArmed
    if low < refLowL
        longPending := false
    else
        if low < bounceLowL
            bounceLowL := low
            bounceLowHighL := high
        if bar_index - bosBarL >= retestBars
            if bounceLowL > refLowL and (not useP2 or minVolRatio <= 0 or volRatioBosL >= minVolRatio)
                longArmed := true
                entryLevelL := bounceLowHighL
                stopLevelL := bounceLowL
                fillDeadlineL := bar_index + fillBars
                armedBarL := bar_index
                stopDistL = math.abs(entryLevelL - stopLevelL)
                qtyRiskL = strategy.equity * riskPct / 100 / stopDistL
                qtyLevL = strategy.equity * maxLev / entryLevelL
                strategy.entry("Long", strategy.long, qty = math.min(qtyRiskL, qtyLevL), stop = entryLevelL)
            else
                longPending := false   // failed volume checklist item too -> discard, no trade

if longArmed and strategy.position_size == 0
    if low < refLowL or bar_index > fillDeadlineL or (useP2 and bar_index - armedBarL > maxFillDelay)
        strategy.cancel("Long")
        longPending := false
        longArmed := false

// ───────────────────────────── exit management ───────────────────────────────
var float shortTrailStop = na
var float longTrailStop  = na

justEnteredShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
justEnteredLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0

if justEnteredShort
    shortTrailStop := stopLevelS
    shortPending := false
    shortArmed := false
if justEnteredLong
    longTrailStop := stopLevelL
    longPending := false
    longArmed := false

if strategy.position_size < 0
    if exitMode == "Swing Trail" and not na(ph) and ph < shortTrailStop
        shortTrailStop := ph
    float tpShort = na
    if exitMode == "Fixed R"
        tpShort := strategy.position_avg_price - rMultiple * math.abs(strategy.position_avg_price - shortTrailStop)
    strategy.exit("Short Exit", "Short", stop = shortTrailStop, limit = tpShort)

if strategy.position_size > 0
    if exitMode == "Swing Trail" and not na(pl) and pl > longTrailStop
        longTrailStop := pl
    float tpLong = na
    if exitMode == "Fixed R"
        tpLong := strategy.position_avg_price + rMultiple * math.abs(strategy.position_avg_price - longTrailStop)
    strategy.exit("Long Exit", "Long", stop = longTrailStop, limit = tpLong)

// ───────────────────────────── visuals ───────────────────────────────────────
plot(lastHigh, "Last swing high", color = color.new(#e34948, 40), style = plot.style_line)
plot(lastLow,  "Last swing low",  color = color.new(#1baf7a, 40), style = plot.style_line)
plot(shortArmed or strategy.position_size < 0 ? shortTrailStop : na, "Short stop",
     color = color.new(#e34948, 0), style = plot.style_linebr, linewidth = 2)
plot(longArmed or strategy.position_size > 0 ? longTrailStop : na, "Long stop",
     color = color.new(#1baf7a, 0), style = plot.style_linebr, linewidth = 2)

plotshape(bosShortNow, "Bearish BOS", shape.triangledown, location.abovebar,
     color.new(#e34948, 0), size = size.tiny)
plotshape(bosLongNow, "Bullish BOS", shape.triangleup, location.belowbar,
     color.new(#1baf7a, 0), size = size.tiny)
plotshape(shortArmed and shortArmed[1] != true, "Failed retest (short)", shape.labeldown,
     location.abovebar, color.new(#eda100, 0), size = size.tiny, text = "FR", textcolor = color.white)
plotshape(longArmed and longArmed[1] != true, "Failed retest (long)", shape.labelup,
     location.belowbar, color.new(#eda100, 0), size = size.tiny, text = "FR", textcolor = color.white)

bgcolor(inUpLeg and bullFVGFlag ? color.new(#1baf7a, 92) : na, title = "Bull FVG active in up-leg")
bgcolor(inDownLeg and bearFVGFlag ? color.new(#e34948, 92) : na, title = "Bear FVG active in down-leg")

var table info = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 65), border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "Part 1", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, "always active", text_color = color.new(#1baf7a, 0), text_size = size.small)
    table.cell(info, 0, 1, "Part 2", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, useP2 ? "ON (fast fill + BOS volume)" : "OFF (Part 1 only)",
         text_color = useP2 ? color.new(#1baf7a, 0) : color.gray, text_size = size.small)
    table.cell(info, 0, 2, "Position", text_color = color.white, text_size = size.tiny)
    table.cell(info, 1, 2, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color = strategy.position_size > 0 ? color.new(#1baf7a,0) : strategy.position_size < 0 ? color.new(#e34948,0) : color.gray, text_size = size.tiny)
